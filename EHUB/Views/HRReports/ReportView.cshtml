    <script src="dist/jquery.highchartTable.js"></script> *@
<script src="~/plugins/reportview/ReportView.js"></script>
    <script type="text/javascript">
        $(document).keypress(function (e) {
            if (e.keyCode === 13) {
                e.preventDefault();
                return false;
            }
        });
        $(document).ready(function () {
        });
    </script>

