@using Newtonsoft.Json.Linq
@{
    ViewData["Title"] = "Leave Application";
    ViewData["pgHeader"] = "Leave Request";
}
<style type="text/css">
    .ft16 {
    font-size: 14px;
    }
    .rd-opt {
    float: left;
    padding-right: 12px;
    }
</style>
<section class="content">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <form asp-controller="Leaves" asp-action="LeaveApplication" enctype="multipart/form-data" method="post" onsubmit="validateData(event)">
                        <div class="row">
                            <div class="col-md-12">
                                <label for="">Leave Request Type</label>
                                <select name="leaveid" id="leaveid" class="form-control">
                                    @foreach (var item in Model.leaveType)
                                    {
                                        <option value="@item.LeaveID" data-bal="@item.balance">@item.Leave</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label>Leave Duration</label>
                                <div class="form-group" style="margin-top: -10px;">
                                    <input type="hidden" id="lvD" name="lvduration" value="1" />
                                    <div class="custom-control custom-radio rd-opt">
                                        <input class="custom-control-input optDuration custom-control-input-primary" type="radio" id="optFull" value="1" name="optD" checked>
                                        <label for="optFull" class="custom-control-label">Full Day(s)</label>
                                    </div>
                                    <div class="custom-control custom-radio rd-opt hq-lv">
                                        <input class="custom-control-input optDuration custom-control-input-primary" type="radio" id="optHalfDay" value="2" name="optD">
                                        <label for="optHalfDay" class="custom-control-label">Half Day</label>
                                    </div>
                                    <div class="custom-control custom-radio rd-opt hq-lv">
                                        <input class="custom-control-input optDuration custom-control-input-primary" type="radio" id="optQuarter" value="3" name="optD">
                                        <label for="optQuarter" class="custom-control-label">Quarter Day</label>
                                    </div>
                               
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="row">
                                    <div class="col-md-4"><label>From Date</label>	<input type="date" id="dtFrom" name="dtFrom" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required="required"></div>
                                    <div class="col-md-4 todate"><label>To Date</label>	<input type="date" id="dtTo" name="dtTo" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required="required"></div>
                                    <div class="col-md-4">
                                        <label>Duration</label>
                                        <span id="Duration" class="form-control"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label>Description</label>
                                <textarea name="Ldesc" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-12">
                                <label>Supporting Document</label>        <div class="clearfix">
                                </div>
                                <input type="file" name="doc" class="" accept="image/png, image/jpeg">
                            </div>
                            <div class="col-md-12">
                                <br />
                                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-file"></i> Post Leave Request</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-md-8">
                    <ul class="nav nav-tabs">
                        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#LeaveRequests"><i class="fas fa-solid fa-shuffle nav-icon "></i> Leave Requests</a></li>
                        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#LeaveSummary"><i class="fas fa-solid fa-person-military-to-person nav-icon "></i> Leave Summary</a></li>
                    </ul>
                    <div class="tab-content">
                        <div id="LeaveRequests" class="tab-pane fade in active show">
                            <table class="table table-striped table-hover collapsed" id="tbleaves">
                                <thead>
                                    <tr>
                                        <th>Request Date</th>
                                        <th>Leave Type</th>
                                        <th>Date</th>
                                        <th>Duration</th>
                                        <th>Leave Status</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.leaves)
                                    {
                                        <tr>
                                            <td>@item.Created.ToString("dd MMM yyyy")</td>
                                            <td>@item.Leave</td>
                                            <td>@item.dtFrom.ToString("dd MMM yyyy") - @item.dtTo.ToString("dd MMM yyyy")</td>
                                            <td>@item.lvduration</td>
                                            @{
                                                string lst = "";
                                                if (item.aprvstat!=null)
                                                {
                                                    JArray jsonArray = JArray.Parse(item.aprvstat);
                                                    
                                                    foreach (var itm in jsonArray)
                                                    {
                                                        
                                                        string emp = itm["emp"].ToString();
                                                        string dt = itm["dtAD"].ToString();
                                                        string stat = itm["stat"].ToString();
                                                        lst += emp+" "+dt+" "+stat + Environment.NewLine;

                                                    }
                                                    
                                                }
                                            
                                               
                                            }
                                            <td title="@lst">
                                                @{
                                                    if (item.aprvstatus == "To Approve")
                                                    {
                                                        <span class="badge bg-primary ft16">To Approve</span>
                                                    }
                                                    else if (item.aprvstatus == "Approved")
                                                    {
                                                        <span class="badge bg-success ft16">Approved</span>
                                                    }
                                                    else if (item.aprvstatus == "Refused")
                                                    {
                                                        <span class="badge bg-danger ft16">Refused</span>
                                                    }
                                                    else if (item.aprvstatus == "In Process")
                                                    {
                                                        <span class="badge bg-warning ft16">In Process</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    if (item.attachment != null)
                                                    {
                                                        <a href='~/dist/img/StaffData/leaves/@item.id/@item.attachment' target="_blank"><i class='fa-solid fa-paperclip'></i></a>
                                                    }
                                                }
                                                @item.Ldesc
                                                <span class="btnsh float-right">
                                                    @if (item.aprvstatus == "To Approve")
                                                    {
                                                        <a class="btn btn-outline-danger btn-xs" onclick="delreq(@item.id)"><i class="fa-solid fa-times"></i> Delete</a>
                                                    }
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="LeaveSummary" class="tab-pane fade">
                            <table class="table table-striped table-hover" id="tbleaves">
                                <thead>
                                    <tr>
                                        <th>Leave Type</th>
                                        <th>Allowed</th>
                                        <th>Taken</th>
                                        <th>Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.lvSumm)
                                    {
                                        <tr>
                                            <td>@item.Leave</td>
                                            <td>@string.Format("{0:F2}", item.Allowed)</td>
                                            <td>@string.Format("{0:F2}", item.took)</td>
                                            <td>@string.Format("{0:F2}", item.bal)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">
    function getNumberOfDays(start, end) {
        const date1 = new Date(start);
        const date2 = new Date(end);
        // One day in milliseconds
        const oneDay = 1000 * 60 * 60 * 24;
        // Calculating the time difference between two dates
        const diffInTime = date2.getTime() - date1.getTime();
        // Calculating the number of days between two dates
        const diffInDays = Math.round(diffInTime / oneDay);
        return (diffInDays + 1) + " day(s)";
    }
    $(document).ready(function () {
        $("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
        $(function () {
            $("#tbleaves").DataTable({
                "ordering": true,
                "responsive": true,
            })
        });
    });
    $("#dtFrom, #dtTo").on('change', function (e) {
        // $("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
        dtUpdate();
    });
    $("#leaveid").on('change', function (e) {
        if ($(this).val() == 2) {
            $(".hq-lv").show();
        } else {
            $(".hq-lv").hide(); $("#optFull").prop("checked", true);
            $("#lvD").val(1);
        }
    });
    $(".optDuration").on('change', function (e) {
        $("#lvD").val($(this).val());
        console.log($("#lvD").val())
        dtUpdate();
    });
    function dtUpdate() {
        if ($("#lvD").val() == "2") {
            $(".todate").hide();
            $("#dtTo").val($("#dtFrom").val());
            $("#Duration").html("0.5 Day");
        }
        else if ($("#lvD").val() == "3") {
            $(".todate").hide();
            $("#dtTo").val($("#dtFrom").val());
            $("#Duration").html("0.25 Day");
        }
        else {
            $(".todate").show();
            $("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
        }
    }

    function validateData(event) {
     let bal=  parseFloat( $("#leaveid option:selected").attr("data-bal"));
     let dur=parseFloat($("#Duration").text());
     if(bal<dur){
        Swal.fire({
      title: "Insufficient balance!",
      text: "You do not have insufficient balance remaining for the selected leave type.!",
      icon: "warning"
    });
                event.preventDefault();
     }

    }
    function delreq(id){
                Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.get("/Leaves/DelReq?id=" + id).done(function (data) {

                    Swal.fire({
                        title: "Deleted!",
                        text: "Record has been deleted.",
                        icon: "success"
                    });
                    location.href = '/Leaves/LeaveApplication';
                });
            }
        });
    }
</script>
