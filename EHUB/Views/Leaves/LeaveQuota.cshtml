@using EHUB.Utilities
@{
    ViewData["Title"] = "Leave Quota Settings";
    ViewData["pgHeader"] = "Staff Leave Quota";
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
}
<style type="text/css">
    .ft16 {
        font-size: 14px;
    }

    .rd-opt {
        float: left;
        padding-right: 12px;
    }

    .select2-container--default .select2-results__group {
        cursor: default;
        display: block;
        padding: 6px;
        background: #e5e5e5;
        color: #2a327d;
    }

    .btnsh {
        opacity: 0;
    }

    tr:hover .btnsh {
        opacity: 1;
    }

    #tbEmps_filter input {
    }

    #tbEmps_wrapper > div:nth-child(1) {
        max-width: 0 !important;
    }
</style>
<section class="content">
    @if (chk != "r" || chk != "")
    {
        <div class="col-md-6" style="margin-bottom: 10px;">
            <a id="btnNewQuota" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Quota</a>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <table id="tbEmps" class="table table-striped table-sm table-hover dataTable no-footer dtr-inline">
                        <thead>
                            <tr>
                                <th>Staff Code - Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.staff)
                            {
                                <tr onclick="QuotaLine(@item.empid);"> <td style="cursor: pointer;">@item.empcode - @item.empname</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-8">
                    <table id="tbquota" class="table table-striped table-md table-hover dataTable no-footer dtr-inline">
                        <thead>
                            <tr>
                                <th>Year</th>
                                <th>Leave Type</th>
                                <th>Allowed</th>
                              
                                <th width="50%">Created By</th>
                            </tr>
                        </thead>
                        <tbody id="tblQuota"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="dgQuota" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">LEAVE QUOTA</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="frmQuota" class="" method="post" asp-controller="Leaves" asp-action="LeaveQuota" enctype="multipart/form-data">
                <div class="modal-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-sm-12">
                                   
                                    <div class="form-group clearfix">
                                        <input type="hidden" id="Mode" name="mode" value="1" />
                                        <div class="icheck-orange d-inline rd-opt">
                                            <input type="radio" id="optDepart" name="optD" value="1" checked class="optMode">
                                            <label for="optDepart">
                                                By Department
                                            </label>
                                        </div>
                                        <div class="icheck-orange d-inline rd-opt">
                                            <input type="radio" id="optEmp" name="optD" value="2" class="optMode">
                                            <label for="optEmp">
                                                By Employees
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-10 staff" style="display: none;">
                                    <label for="">Staff</label>
                                    <select name="EmpIds[]" id="staffid" class="form-control select2" multiple="multiple" style="width:100%">
                                        @foreach (var item in Model.staff)
                                        {
                                            <option value="@item.empid">@item.empcode - @item.empname</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-10 depart">
                                    <label for="">Department</label>
                                    <select name="DepartIds[]" id="departid" class="form-control select2" multiple="multiple" style="width:100%">
                                        @foreach (var d in Model.departs)
                                        {
                                            <optgroup label="@d.Depart"></optgroup>
                                            @foreach (var item in d.SubDepartments)
                                            {
                                                <option value="@item.DepartID">@item.Depart</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                  
                                        <label>Year</label>
                                    <input type="number" id="yrQuota" name="yrQuota" min="2024" value="@DateTime.Now.ToString("yyyy")" class="form-control" required="required">
                        
                                </div>
                                <div class="col-md-10">
                                    <label for="">Leave Type</label>
                                    <select name="LeaveID" id="LeaveID" class="form-control select2" style="width:100%">
                                        @foreach (var l in Model.leavetyps)
                                        {


                                            <option value="@l.LeaveID">@l.Leave</option>
                                        
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">

                                    <label>Leave Allowed</label>
                                    <input type="number" id="Allowed" min="1" name="Allowed"  class="form-control" required="required">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-fw fa fa-save"></i>&nbsp;Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">

    $(document).ready(function () {
      
        $(function () {
            $("#tbquota").DataTable({
                "ordering": false,
                "responsive": true,
            })
            $('#tbEmps').DataTable({
                // "bPaginate": false
            });
        });
        $("#EmpId").on('change', function (e) {
            QuotaLine($("#EmpId").val());
        });
    });

    $('#btnNewQuota').on('click', function () {
        $('.frm').val('');
        $('#dgQuota').modal("show");
    });
    $(".optMode").on('change', function (e) {
        $("#Mode").val($(this).val());
        if ($("#Mode").val() == "1") {
            $(".staff").hide();
            $(".depart").show();
        }
        else {
            $(".staff").show();
            $(".depart").hide();
        }
    });
    function loadquota(obj) {
        var quotas = ""
        for (const e of obj) {
            quotas += "<tr><td>" + e.yrQuota + "</td><td>" + e.leave + "</td><td contenteditable onfocusout='UpdateQuota(this)' data-id=" + e.quotaID + ">" + e.allowed + "</td><td title='" + (e.modifyby != null ? (e.modifyby + " @@ " + e.modify) : "") + "'>" + e.createdby + " @@ " + e.created + "<span class='btnsh float-right'><a onclick='DelQuota(" + e.quotaID + ")' class='btn btn-outline-danger btn-xs'><i class='fa-solid fa-trash fa-beat'></i> Delete</a></span></td></tr>";
        }
        $("#tblQuota").html(quotas);
    }

    function UpdateQuota(ele){
           var me = $(ele);
               let  value = me.html().replace(/[^0-9.]/g, '');

      // Ensure only one decimal point is allowed
      // if ((value.match(/\./g) || []).length > 1) {
      //   value = value.replace(/\.+$/, '');  // Remove the last dot if more than one is found
      // }
            $.ajax({
                url: "UpdateQuota?ID=" + me.attr("data-id")+"&txt="+value,
                context: document.body,
                success: function () {
                    me.html(value);
                }
            });
    }
    function DelQuota(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.get("/Leaves/DelQuota?id=" + id).done(function (data) {
                    loadquota(data);
                    Swal.fire({
                        title: "Deleted!",
                        text: "Record has been deleted.",
                        icon: "success"
                    });
                });
            }
        });
    }
    function QuotaLine(id) {
        $.get("/Leaves/GetQuota?id=" + id).done(function (obj) {
            var quotas = ""
            for (const e of obj) {
                quotas += "<tr><td>" + e.yrQuota + "</td><td>" + e.leave + "</td><td contenteditable onfocusout='UpdateQuota(this)' data-id=" + e.quotaID + ">" + e.allowed + "</td><td title='" + (e.modifyby != null ? (e.modifyby + " @@ " + e.modify) : "") + "'>" + e.createdby + " @@ " + e.created + "<span class='btnsh float-right'><a onclick='DelQuota(" + e.quotaID + ")' class='btn btn-outline-danger btn-xs'><i class='fa-solid fa-trash fa-beat'></i> Delete</a></span></td></tr>";
            }
            $("#tblQuota").html(quotas);
        });
    }
    $('#tbEmps tr').each(function (a, b) {
        $(b).click(function () {
            $('#tbEmps tr').css('font-weight', 'normal').css('color', '#000');
            $(this).css('font-weight', 'bold').css('color', '#2a327d');
        });
    });
</script>
