    <script type="text/javascript">
        var tb; var xy = ""; var axis = 0; var ctyp = "column";
        $(document).ready(function () {
            var ddData;
            ListData("0");
            function ListData(s) {
                $.ajax({
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    url: "Lists",
                    data: '{"s":"' + s + '"}',
                    context: document.body,
                    success: function (responseText) {
                        ddData = $.parseJSON(responseText);
                    }
                });
            }
            $('#chart-type').change(function () {
                if ($(this).prop('checked')) {
                    $('.trpovt').show("slow"); $('.trChart').hide(); $('#spName').attr('tag', $('#spName').attr('data-sp2')); $('#spName').attr('data-typ', 1);
                } else {
                    $('.trpovt').hide(); $('.trChart').show("slow"); $('#spName').attr('tag', $('#spName').attr('data-sp1')); $('#spName').attr('data-typ', 0);
                }
            });
            $(document.body).on('click', ".btAdd", function () {
                var row = '<tr tag="' + $("#ddData").val() + '"><td>' + $("#ddData :selected").text() + '</td><td><div class="delR">&nbsp;&nbsp;</div></td></tr>';
                $('#vArea tbody').html($('#vArea tbody').html() + row);
            });
            $(document.body).on('click', ".delR", function () {
                $(this).parent().parent().remove();
            });
            $(document.body).on('change', '.ddVlaue', function () {
                if ($(".ddColumn").val() == "ProjectID") {
                    ListData($(".ddVlaue").val());
                }
            });
            $(document.body).on('change', '.ddColumn', function () {
                var col = $(this);
                if (col.val().match(/^.*Date.*$/)) {
                    col.parent().parent().find('.ddVlaue').parent().html('<input type="date" class="ddVlaue form-control" />');
                } else {
                    col.parent().parent().find('.ddVlaue').parent().html('<select class="ddVlaue form-control" style="min-width: 100px"></select>');
                    var opts = "";
                    if (ddData[col.val()] != undefined) {
                        $.each(ddData[col.val()], function (i, item) {
                            opts = opts + '<option value="' + (item.val == undefined ? item.txt : item.val) + '">' + item.txt + '</option>';
                        });
                        col.parent().parent().find('.ddVlaue').html(opts);
                        col.parent().parent().find('.ddVlaue').trigger('change');
                        col.parent().parent().find('.ddVlaue').eComboBox();
                        col.parent().parent().find('.ddVlaue option:contains({NEW ELEMENT})').remove();
                    } else { col.parent().parent().find('.ddVlaue').html('<option>0</option>'); $(".ddVlaue").eComboBox(); }
                }
            });
            var PvtValues = ''; var Wheres = ""; var colmns = ''; var grps = '';
            $('#chkXY').parent().hide();
            $(".ddVlaue").eComboBox();
            $(document).on("click", ".btAd:last", function () {
                var row = '<tr>' + $('#tb-parm tbody  tr:last').html() + '</tr>';
                $('#tb-parm tbody  tr:last').after(row);
                $(".ddVlaue:last").eComboBox();
                $(".ddVlaue:last").html('<option></option>');
                //$(".ddColumn").on('change', function (e) {
                //    var opts = "";
                //    if (ddData[$(this).val()] != undefined) {
                //        $.each(ddData[$(this).val()], function (i, item) {
                //            opts = opts + '<option>' + item.txt + '</option>';
                //        });
                //        $(this).parent().parent().find('.ddVlaue').html(opts);
                //        $(this).parent().parent().find('.ddVlaue').eComboBox();
                //        $(this).parent().parent().find('.ddVlaue option:contains({NEW ELEMENT})').remove();
                //    } else { $(this).parent().parent().find('.ddVlaue').html('<option>0</option>'); $(".ddVlaue").eComboBox(); }
                //});
            });
            $(document).on("click", ".btnr", function () {
                if ($('#tb-parm tbody  tr').length > 1) {
                    $(this).parent().parent().remove();
                }
            });
            $(document.body).on('click', '.card-header', function () {
                // $(".card-header").click(function (e, el) {
                // var index = $(".card-header").index($(this));
                //         if ($(".box-body").eq(index).is(":visible")) {
                //             $(".box-body").eq(index).hide(500);
                //         } else {
                //             $(".box-body").eq(index).show(500);
                //         }
                // $('.prmhdr').trigger('click');
            });
            $(document.body).on('click', '#sortable1 li', function () {
                if ($(this).parent()[0].nodeName === "SPAN") {
                    $($(this).parent()).appendTo('#sortable2');
                } else {
                    $(this).appendTo('#sortable2');
                }
            });
            $(document.body).on('click', '#sortable2 li', function () {
                if ($(this).parent()[0].nodeName === "SPAN") {
                    $($(this).parent()).appendTo('#sortable1');
                } else {
                    $(this).appendTo('#sortable1');
                }
            });
            $(function () {
                $("ul.droptrue").sortable({
                    connectWith: "ul"
                });
                $("ul.dropfalse").sortable({
                    connectWith: "ul"
                });
                $("#sortable1, #sortable2, #sortable3").disableSelection();
            });
            $("#btnShRpt").click(function (e) {
                PvtValues = ''; Wheres = ""; colmns = ''; grps = '';
                for (i = 0; i < $('#sortable2 li').length; i++) {
                    colmns = colmns + ',' + $($('#sortable2 li')[i]).attr('tag') + ' as [' + $('#sortable2 li')[i].innerHTML + ']';
                    if ($($('#sortable2 li')[i]).hasClass('grp')) {
                        grps = grps + ',' + $($('#sortable2 li')[i]).attr('tag');
                    }
                }
                $('#vArea tr').each(function () {
                    PvtValues = PvtValues + "," + $(this).attr('tag');
                });
                $('#tb-parm tbody tr').each(function () {
                    if (($(this).children().find('.ddVlaue').val() != "") && ($(this).children().find('.ddVlaue').val() != "{NEW ELEMENT}")) {
                        if ($(this).children().find('.ddVlaue').val() != null) {
                            if (($(this).children().find('.ddOperator')).find('option:selected').text() == "Alike") {
                                Wheres = Wheres + $(this).children().find('.ddAR').val() + "  " + $(this).children().find('.ddColumn').val() + $(this).children().find('.ddOperator').val() + "''" + $(this).children().find('.ddVlaue').val() + "''";
                            } else {
                                Wheres = Wheres + $(this).children().find('.ddAR').val() + "  " + $(this).children().find('.ddColumn').val() + $(this).children().find('.ddOperator').val() + (($(this).children().find('.ddColumn').val()).indexOf('Date') !== -1 ? "convert(date,''" + ($(this).children().find('.ddVlaue').val()) + "'')" : "''" + ($(this).children().find('.ddVlaue').val()) + "''");
                            }
                        }
                    }
                });
                if (Wheres != "") {
                    Wheres = "WHERE " + Wheres.substring(4);
                }
                if ($('#spName').attr('data-typ') == "1") {
                    grps = "0" + $('#ddRows').val() + "'',''" + (PvtValues == "" ? $('#ddData').val() : PvtValues.substring(1));
                    colmns = "1" + $('#ddCol').val();
                    Wheres = Wheres.replace(/'/g, '\'\'');
                }
                loadRpts(grps, colmns, Wheres);
                $('.prmhdr').trigger('click');
                // $('.rptdtl').trigger('click');
            });
            $(function () {
                $('#chkT').change(function () {
                    if ($(this).prop('checked')) {
                        $('#chrt-tb1').hide();


                    } else {
                        $('#chrt-tb1').show();

                    }
                });
                $('#chkC').change(function () {
                    if ($(this).prop('checked')) {
                        $('.highcharts-container').hide();
                        $('#chkXY').parent().hide(); $('#cgrp').hide();
                    } else {
                        $('.highcharts-container').show(); $('#chkXY').parent().show(); $('#cgrp').show();
                    }
                });
                var table;
                $('#chkaddfilter').change(function () {

                    if ($(this).prop('checked')) {
                        table.destroy();

                    } else {
                        table = new DataTable('#chrt-tb1');

                    }
                });
                $('#chkXY').change(function () {
                    if ($(this).prop('checked')) {
                        xy = ""; axis = 1;
                        loadRpts(grps, colmns, Wheres);
                        $('.highcharts-container').show();
                    } else {
                        xy = "1"; axis = 1;
                        loadRpts(grps, colmns, Wheres);
                        $('.highcharts-container').show();
                    }
                });
            })
            $("#btnBar").click(function (e) {
                ctyp = "column"; axis = 1;
                loadRpts(grps, colmns, Wheres);
            });
            $("#btnPi").click(function (e) {
                ctyp = "pie"; axis = 1;
                loadRpts(grps, colmns, Wheres);
            });
            $("#btsvRpt").click(function (e) {
                $('#modal-svbox').modal('show');
            });
            $("#btnLine").click(function (e) {
                ctyp = "line"; axis = 1;
                loadRpts(grps, colmns, Wheres);
            });
            $("#adSec").hide();
            $(".chkc").click(function () {
                if ($('#ys').is(':checked')) { $("#newRpt").show(); $("#adSec").hide(); $("#add-rpt").html('Save Report'); } else {
                    $("#newRpt").hide(); $("#adSec").show(); $("#add-rpt").html('Add Section');
                    $.ajax({
                        url: "ReportList",
                        context: document.body,
                        success: function (responseText) {
                            $('#ddRpts').html(responseText);
                        }
                    });
                }
            });
            $("#add-rpt").on('click', function (e) {
                var tbv = 0, chrt = 0;
                if ($("#chrt-tb1").is(":visible")) {
                    tbv = 1;
                } else { tbv = 0; }
                if ($('.highcharts-container').is(":visible")) {
                    chrt = 1;
                } else { chrt = 0; }
                if ($("#add-rpt").html() == "Save Report") {
                    if ($('#txtTitle').val() == "") {
                        msgbox("Please enter Report Title ");
                        return false;
                    }
                    var dataIN = "Ï''" + $('#spName').attr('tag') + "'',''" + grps.substring(1).replace(/'/g, "''") + "'',''" + colmns.substring(1) + "'',''" + $("#txtRemars").val() + "'',''0'',''" + Wheres.replace(/'/g, '\'\'').replace("lk'", " like '").replace(/''''''''/g, "''''") + "'',''" + tbv + "'',''0'',''" + xy + "'',''" + ctyp + "'',''0'',''" + chrt + "''Î:" + $("#txtTitle").val() + ":" + $('#chkdshb').prop('checked') + ":0";
                    $.ajax({
                        url: "SaveReport?info=" + encodeURIComponent(dataIN),
                        context: document.body,
                        success: function (responseText) {
                            $('#modal-svbox').modal('hide');
                        }
                    });
                } else {
                    if ($('#ddRpts').val() == null) {
                        msgbox("Please select Report Title ");
                        return false;
                    }
                    var dataIN = "'" + $('#spName').attr('tag') + "','" + grps.substring(1).replace(/'/g, "''") + "','" + colmns.substring(1) + "','" + $("#txtRemars").val() + "','0','" + Wheres.replace(/'/g, '\'\'').replace("lk'", " like '").replace(/''''''''/g, "''''") + "','" + tbv + "','0','" + xy + "','" + ctyp + "','0'," + $("#ddRpts").val() + ",'" + chrt + "')";
                    $.ajax({
                        url: "SaveSection?info=" + encodeURIComponent(dataIN),
                        context: document.body,
                        success: function (responseText) {
                            $('#modal-svbox').modal('hide');
                        }
                    });
                }
            });
        });
        function loadRpts(grps, colmns, Wheres) {
            $('#oResult').html('');

            if ($('.rptD').is(':visible') == false) { $('.rptdtl').trigger('click'); }
            // $('.rptD').show();
            // $('.rptP').hide();
            //NProgress.start();
            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                url: "ReportDTLs",
                data: '{"RptID":"","width":"' + $('#oResult').width() + '","xy":"' + xy + '","ctyp":"' + ctyp + '"}',
                success: function (responseText) {
                    var dtlData = (responseText).split('¦');
                    $.each(dtlData, function (index, value) {
                        if (value != "") {
                            var rptSec = value.split('|');
                            $('#oResult').html($('#oResult').html() + "<div class='dtlD' style='float: left;min-height:" + rptSec[12] + "px;min-width:" + rptSec[13] + "px;'><div class='titG' id=t" + rptSec[10] + " class='tRpt'>" + decodeURIComponent(rptSec[3]) + "</div><div style='margin-left: 20px;'></div><div id='c" + rptSec[10] + "' class='chrt' style='margin-left: 90px;margin-bottom: 20px;margin-top: 20px;'></div>");
                            if (rptSec[8] == 'y') {
                                //$("#preloader2").show();
                                $.ajax({
                                    type: "POST",
                                    contentType: "application/json; charset=utf-8",
                                    url: "ReportData",
                                    data: '{"sp":"' + $('#spName').attr('tag') + '","Grps":"' + encodeURIComponent(grps.substring(1)) + '","Columns":"' + encodeURIComponent(colmns.substring(1)) + '","Wheres":"' + encodeURIComponent(Wheres) + '","ID":"' + rptSec[10] + '","xy":"' + rptSec[1] + '"}',
                                    success: function (responseText) {
                                        $("#c" + rptSec[10]).html(responseText);
                                        if (rptSec[11] == '1') {
                                            if (rptSec[9] == "pie") {
                                                $("#chrt-tb" + rptSec[10]).attr('data-graph-datalabels-enabled', '1');
                                                $('#chrt-tb' + rptSec[10] + ' tbody tr').each(function () {
                                                    $('td:nth-child(2)', this).attr('data-graph-name', $(':nth-child(1)', this).html());
                                                });
                                            }
                                            tb = $("#chrt-tb" + rptSec[10]);
                                            tb.attr('data-graph-height', rptSec[12]);
                                            tb.attr('data-graph-type', rptSec[9]); tb.attr('data-graph-container-before', '1');
                                            if (rptSec[5] == '1') {
                                                tb.attr('data-graph-inverted', '1');
                                                tb.attr('data-graph-xaxis-labels-enabled', '1');
                                            }
                                            if (rptSec[1] == '1') {
                                                tb.attr('data-graph-yaxis-1-stacklabels-enabled', '1');
                                            }
                                            tb.highchartTable();
                                            $("#c" + rptSec[10]).css('margin-left', '0px').css('width', '100%');
                                            //$("#chrt-tb" + rptSec[10]).css('margin-left', '20px');
                                            $(".chrt-tb" + rptSec[10]).css('overflow', 'auto').css('width', '100%');
                                            $('defs').next().hide();
                                            window.dispatchEvent(new Event('resize'));
                                            if (axis == 0) {
                                                $('.highcharts-container').hide();
                                            }
                                        } else { $("#c" + rptSec[10]).css('margin-left', '0px'); }
                                        //sumTable("chrt-tb" + rptSec[10]);
                                        //if (rptSec[6] == 0) { tb.hide(); } else {
                                        $('#chrt-tb' + rptSec[10] + ' td').each(function () {
                                            if ($.isNumeric($(this).html())) {
                                                //$(this).html(FormatNum($(this).html()) + ""); $(this).css('text-align', 'right');
                                            }
                                            $(this).html($(this).html().replace(",.", "."));
                                        });
                                        //}
                                        if ($('#chkT').prop('checked')) {
                                            $('#chrt-tb1').hide();
                                        } else {
                                            $('#chrt-tb1').show();
                                            // $(function () {
                                            //     $("#chrt-tb1").DataTable({
                                            //         "ordering": true,
                                            //         "responsive": true,
                                            //     })
                                            // });
                                        }
                                        //if (index == 9) { $("#preloader2").hide(); clearInterval(interval); }
                                        $('text').each(function () {
                                            if (($(this).html().replace(",", "")) == ($('th:contains(AV)').attr('tag'))) {
                                                $(this).html("");
                                            }
                                        });
                                        //NProgress.done();
                                        //NProgress.remove();
                                    }
                                });
                            }
                        }
                    });
                }
            });
        }

        function FormatNum(num) {
            var p = num.toString().split(".");
            var d = "";
            if (p[1] != undefined) {
                d = "." + p[1];
            }
return "" + p[0].split("").reverse().reduce(function (acc, num, i, orig) {
                return num + (i && !(i % 3) ? "," : "") + acc;
            }, "") + d;
        }
    </script>
