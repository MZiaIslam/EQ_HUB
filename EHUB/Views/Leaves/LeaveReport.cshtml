<style type="text/css">

    #btnExcel {
        font-size: 12px;
        line-height: 1.5;
        font-family: 'Source Sans Pro','Helvetica Neue',Helvetica,Arial,sans-serif,FontAwesome;
    }

    table thead tr th {
        background: #eaece9;
    }

    #vArea td {
        text-align: center;
    }

    .Grd:hover {
        cursor: pointer;
    }

    .dropfalse .btn {
        color: #1b1b1b !important;
        background-color: #f5f5f5;
        border-color: #cecece;
    }

        .dropfalse .btn:hover {
            color: #fff !important;
            background-color: #ff821d;
        }

    .droptrue .btn {
        color: #ffffff !important;
        background-color: #ff821d;
        border-color: #ffa567;
    }

    .ddColumn {
        width: 100%;
    }

    .ddVlaue {
        width: 100%;
    }


    .ranges li {
        float: left;
        margin: 1px 1px 1px 1px;
    }

    .delR {
        background-image: url(/dist/img/close.ico);
        background-repeat: no-repeat;
        width: 20px;
        margin-left: 20px;
        cursor: pointer;
        background-position-y: center;
    }

    .ranges li {
        font-size: 13px;
        padding: 3px 5px;
    }

    .h4 {
        font-size: large;
        border-bottom: 3px solid #2a327d;
        color: #2a327d;
    }

    .rptP {
        padding-top: 8px;
    }
</style>
