@model EHUB.Models.Home.Expense
@using (Html.BeginForm(Model.Id == 0 ? "ExpenseCreate" : "ExpenseEdit", "Session", FormMethod.Post, new { id = "expenseForm" }))
{
    <div class="row">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="col-md-6">
            @Html.LabelFor(m => m.Date)
            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.ReceiptNo)
            @Html.TextBoxFor(m => m.ReceiptNo, new { @class = "form-control" })
        </div>
        <div class="col-md-12">
            @Html.LabelFor(m => m.Category)
            @Html.DropDownListFor(m => m.Category,
            new SelectList(new[] { "Supplies", "Utilities", "Rent", "Salary", "Maintenance", "Misc" }),
                "-- Select Category --", new { @class = "form-control", required = "required" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.Amount)
        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.PaymentMethod)
        @Html.DropDownListFor(m => m.PaymentMethod,
                new SelectList(new[] { "Cash", "Bank Transfer", "Credit Card" }),
                "-- Select --", new { @class = "form-control", required = "required" })
    </div>
    <div class="col-md-12">
        @Html.LabelFor(m => m.Notes)
        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 3 })
    </div>
</div>
<div class="modal-footer">
    <button type="submit" class="btn btn-primary"><i class="fa fa-fw fa fa-save"></i> Save</button>
</div>
}
