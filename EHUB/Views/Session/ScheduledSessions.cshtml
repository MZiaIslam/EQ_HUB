@using EHUB.Utilities
@{
    ViewData["Title"] = "Scheduled Sessions";
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
}
<style type="text/css">
    .btnsh {
        opacity: 0;
    }
    tr:hover .btnsh {
        opacity: 1;
    }
</style>
<div class="row wrapper">
    @if (chk != "r" || chk != "")
    {
        <div class="col-md-6" style="margin-top: -34px;">
            <a type="button" asp-controller="Session" asp-action="CreateSchedule" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i>   Create New Schedule</a>
        </div>
    }
    <div class="col-md-6">
        <div class="text-right">
        </div>
    </div>
    <div class="col-12" style="padding-top: 12px;">
        <div class="clearfix">
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">Search Parameters</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool prmhdr" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body" style="display: block;padding-top: 0px;">
                <form asp-controller="Session" asp-action="ScheduledSessions" enctype="multipart/form-data" method="post" id="frmSearch">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Student</label>
                            <select class="form-control select2" asp-items="Model.emps" name="emp">
                                <option value="0">ANY</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Session Date</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <input type="checkbox" onclick="toggleDT()" id="chkdt" name="chkdt">
                                    </span>
                                </div>
                                <input type="date" value="@(Model.fills == null || Model.fills.fromdate == null ? "" : Model.fills.fromdate.ToString("yyyy-MM-dd"))" id="fromdate" class="form-control" disabled name="fromdate"><input id="todate" value="@(Model.fills == null || Model.fills.todate == null ? "" : Model.fills.todate.ToString("yyyy-MM-dd"))" type="date" class="form-control" disabled name="todate">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label>Tutor</label>
                            <select class="form-control select2" asp-items="Model.depart" name="empstat">
                                <option value="0">ANY</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-12" style="padding: 5px 1px;">
                        <button type="submit" id="btnShRpt" class="btn btn-primary btn-sm"><i class="fa fa-magnifying-glass"></i>&nbsp;Search Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card card-default">
            <div class="card-body" style="display: block;">
                <table id="tblStaff" class="table table-striped table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Search Record(s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.students)
                        {
                            <tr>
                                <td>
                                    <ul class="products-list product-list-in-card pl-2 pr-2">
                                        <li>
                                            <div class="" style="float: left;">
                                                <img src="/dist/img/StudentData/pics/@(item.StudentID).png" onerror="this.onerror=null;this.src='/dist/img/StaffData/pics/usr.png';" alt="User Image" style="width: 80px;">
                                            </div>
                                            <div class="" style="margin-left: 90px;">
                                                <span class="" style="font-weight: 600;" title="Student name">
                                                    @item.StudentName
                                                </span><span class="badge @(item.Stat == "Active" ? "badge-success" : "badge-danger") float-right">@(item.Stat)</span>
                                                <span class="product-description" title="Parent/Guardian name">
                                                    @item.Guardian (@item.Relationship)
                                                    <span class="float-right" title="Student application date"><i class="fa-solid fa-calendar-days"></i> @item.AppDate</span>
                                                </span>
                                                <span class="float-right" title="Parent/Guardian phone number"><i class="fa-solid fa-mobile-screen-button"></i> @item.CellNo</span><a title="Parent/Guardian email">
                                                    <i class="far fa-envelope"></i> @item.Email
                                                </a>
                                                <br />
                                                <span title="School attended"><i class="fa-solid fa-location-dot"></i> @item.School</span>
                                                <span class="btnsh float-right">
                                                    @if (chk == "f")
                                                    {
                                                        <a class="btn btn-outline-danger btn-xs" asp-controller="Session" asp-action="EditSchedule" asp-route-id="@item.Gender"><i class="fa-solid fa-calendar-day"></i> Edit</a>
                                                    }
                                                </span>
                                            </div>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
@* <script src="../../plugins/jquery/jquery.min.js"></script> *@
<script type="text/javascript">
    $(function () {
        $("#tblStaff").DataTable({
            "ordering": false,
            "responsive": true,
        })
    });
    $(document).ready(function () {
        $(".preloader").hide();
       var isPrm ="@(Model.fills == null ? "" : Model.fills.empstat)";
       if (isPrm != "") {
       $('.prmhdr').trigger("click");
       }
        var isChecked ="@(Model.fills == null ? "" : Model.fills.chkdt)";
        if (isChecked === "on") {
            $('#chkdt').trigger("click");
        } else {
            $('#chkdt').prop('checked', false);
        }
    });
        function toggleDT() {
    $('#fromdate').prop('disabled', !$('#chkdt').prop("checked"));
    $('#todate').prop('disabled', !$('#chkdt').prop("checked"));
        $('#fromdate').prop('required', $('#chkdt').prop("checked"));
    $('#todate').prop('required', $('#chkdt').prop("checked"));
    }
    history.pushState(null, "", location.href);
           window.onpopstate = function() {
               location.reload();
           };
</script>