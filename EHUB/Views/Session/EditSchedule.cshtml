@using Newtonsoft.Json
@{
    ViewData["Title"] = "Edit Schedule";
    ViewData["pgHeader"] = "Session Schedule";
}
<style type="text/css">
    .select2-container--default .select2-results__group {
        cursor: default;
        display: block;
        padding: 6px;
        background: #e5e5e5;
        color: #2a327d;
    }
    .btnsh {
        opacity: 0;
    }
    tr:hover .btnsh {
        opacity: 1;
    }
    .ft16 {
        font-size: 14px;
    }
    .select2-container {
        width: 100% !important;
    }
</style>
<section class="content">
    <div class="card">
        <div class="card-body">
            <form asp-controller="Session" asp-action="EditSchedule" enctype="multipart/form-data" method="post">
                <div class="row">
                    <div class="col-md-3" style="display:none;">
                        <label>Student</label>
                        <select class="form-control" asp-items="Model.stuList" name="StudentID" id="StudentID">
                            <option></option>
                        </select>
                        <input type="hidden" name="SessionId" id="SessionId" value="@Model.Sess.SessionId" />
                    </div>
                    <div class="col-md-2" style="display:none;">
                        <label for="">Grade Level</label>
                        <select id="GradeID" name="GradeID" class="form-control">
                            @foreach (var item in Model.grade)
                            {
                                <option value="@item.GradeID">@item.GradeLevel</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12">
                        <div class="row" style="padding-top: 10px;" id="staffcard">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-4 shref">
                                <label for="">Total Hours Purchased</label>
                                <input type="number" name="PurchasedHrs" id="PurchasedHrs" class="form-control" required value="@Model.Sess.PurchasedHrs">
                            </div>
                            <div class="col-md-4 shref">
                                <label for="">Total Amount</label>
                                <input type="number" name="TotalAmt" id="TotalAmt" class="form-control" required value="@Model.Sess.TotalAmt">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <span class="badge badge-primary" style="margin: 3px;padding: 10px;">
                            Assigned Hours
                            <small><br>(Scheduled for Tutor)</small>
                            <p style="padding: 1px 0px 2px 0px;margin: 0;font-size: x-large;">@(Model.Sess.Scheduled + Model.Sess.Completed)</p>
                        </span>
                        <span class="badge badge-success" style="margin: 3px;padding: 10px;">
                            Completed Hours
                            <small><br>(Completed by Tutor)</small>
                            <p style="padding: 1px 0px 2px 0px;margin: 0;font-size: x-large;">@Model.Sess.Completed</p>
                        </span>
                        <span class="badge badge-danger" style="margin: 3px;padding: 10px;">
                            Cancel Hours
                            <small><br>(Canceled by Tutor)</small>
                            <p style="padding: 1px 0px 2px 0px;margin: 0;font-size: x-large;">@Model.Sess.Cancel</p>
                        </span>
                        <span class="badge badge-warning" style="margin: 3px;padding: 10px;">
                            Pendding Hours
                            <small><br>(Assigned-Completed)</small>
                            <p style="padding: 1px 0px 2px 0px;margin: 0;font-size: x-large;">@(Model.Sess.Scheduled)</p>
                        </span>
                        <span class="badge badge-info" style="margin: 3px;padding: 10px;">
                            Balance Hours
                            <small><br>(Purchased-Completed)</small>
                            <p style="padding: 1px 0px 2px 0px;margin: 0;font-size: x-large;" id="txtBalance">@(Model.Sess.PurchasedHrs - Model.Sess.Completed)</p>
                        </span>
                    </div>
                    <div class="col-md-12 shref">
                        <br />
                        <button type="button" data-toggle="modal" data-target="#dgSchedule" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> Add Schedule</button>
                    </div>
                    <div class="col-md-12 shref">
                        <br />
                        <div class="card card-default">
                            <div class="card-body" style="display: block;">
                                <table id="tblSchedules" class="table table-striped table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Timings</th>
                                            <th>Subjects</th>
                                            <th>Tutor</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.SchLines)
                                        {
                                            <tr>
                                                <td data-order="@item.StartTime">@item.StartTime.ToString("dd MMM yyyy")</td>
                                                <td>@item.StartTime.ToString("hh:mm tt") - @item.EndTime.ToString("hh:mm tt") (@item.sMin)</td>
                                                <td>@item.subjects</td>
                                                <td>@item.tutor</td>
                                                <td>
                                                    @{
                                                        var badgeClass = item.Stat switch
                                                        {
                                                            "Scheduled" => "bg-primary",
                                                            "Completed" => "bg-success",
                                                            "Cancel" => "bg-danger",
                                                            _ => ""
                                                        };
                                                    }
                                                    <span class="badge @badgeClass ft16">@item.Stat</span>
                                                </td>
                                                <td>
                                                    @if (item.Stat == "Scheduled")
                                                    {
                                                        <a class="btn btn-outline-danger btn-xs" onclick="RemoveSch(@item.Id,this)"><i class="fa-solid fa-remove"></i> Remove</a>
                                                    }
                                                    <a class="btn btn-outline-success btn-xs" href="/home/Feedback/@item.Id"><i class="fa-solid fa-comment-dots"></i> Feedback</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal" id="dgSchedule" style="display: none;">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Set Schedule</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="">Start Time</label>
                                        <input name="StartTime" type="datetime-local" class="form-control" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="">End Time</label>
                                        <input name="EndTime" type="datetime-local" class="form-control" required>
                                    </div>
                                    <div class="col-md-12">
                                        <label>Recurrence</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">
                                                    <input type="checkbox" id="Recurrence" value="0" name="Recurrence">
                                                </span>
                                            </div>
                                            <lable class="form-control"><small>Generate all matching weekdays in the month with a specific time</small></lable>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label for="">Subjects</label><br />
                                        <select id="Subjects" name="Subjects[]" multiple="multiple" asp-items="Model.SbjcList" class="form-control select2" required></select>
                                    </div>
                                    <div class="col-md-12">
                                        <label for="">Tutor</label>
                                        <select id="TutorID" name="TutorID" asp-items="Model.EmpList" class="form-control" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button id="btnSetSchedule" type="submit" class="btn btn-danger">Set Schedule</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<script type="text/javascript">
    function getProfile() {
        $.get("/Session/Profile?stuid=" + $("#StudentID").val()).done(function(obj) {
            $("#staffcard").html("");
            $(".shref").hide();
            for (const e of obj) {
                let tt = `<div class="col-md-6"><div style="float: left;"><img src="/dist/img/StudentData/pics/${e.studentID}.png" onerror="this.onerror=null;this.src=\'/dist/img/StaffData/pics/usr.png\';" alt="User Image" style="width: 80px;"></div><div style="margin-left: 90px;"><h6 ><i class="fas fa-clipboard-user"></i><b> ${e.studentName}</b></h6><span  style="font-weight: 600;">${e.guardian}</span><span class="product-description"> (${e.relationship})</span><p>${e.email}</p></div></div><div class="col-md-6">
                                <span><strong>Phone Number:</strong> ${e.cellNo}</span><br>
        <span><strong>Date of Birth:</strong> ${e.dob}</span><br><span><strong>School Attended:</strong> ${e.school}</span>
                            </div><div class="col-md-6">
                                <span><strong>Subjects of Interest:</strong> ${e.subjects}</span><br>
        <span><strong>Current Academic Performance:</strong> ${e.acadPerformance}</span><br><span><strong>Learning Goals:</strong> ${e.learningGoals}</span>
                            </div><div class="col-md-6">
                                <span><strong>Preferred Tutoring Format:</strong> ${e.tutoringFormat}</span><br>
        <span><strong>Preferred Schedule:</strong> ${e.preferredSchedule}</span><br><span><strong>Preferred Frequency:</strong> ${e.sessionsFrequency}</span><br>
        <span><strong>Learning Disabilities:</strong> ${e.healthConcerns}</span>
                            </div>`;
                $("#staffcard").html(tt);
                $("#GradeID").val(e.gradeID);
                $(".shref").show();
            }
        });
    }
    $(document).ready(function() {
        if ("@(Model.Sess.SessionId ?? "")" == "") {
            $(".shref").hide();
        } else { getProfile(); }
        $(document).on("change", "#StudentID", function(e) {
            getProfile();
        });
        $(document).on("change", "#PurchasedHrs, #TotalAmt", function(e) {
            let PurchasedHrs = $("#PurchasedHrs").val();
            let AMT = $("#TotalAmt").val();
            let ID = $("#SessionId").val();
            let Completed =@Model.Sess.Completed
                $("#txtBalance").html(PurchasedHrs - Completed);
            $.get(`/Session/SetPurchasedHrs?PurchasedHrs=${PurchasedHrs}&AMT=${AMT}&id=${ID}`).done(function(data) { });
        });
        $("#GradeID").val('@(Model.Sess.GradeID ?? "")');
        $(document.body).on("click", "#Recurrence", function() {
            if ($(this).prop("checked")) {
                $("#Recurrence").val("1");
            } else {
                $("#Recurrence").val("0");
            }
        });
        $(function() {
            $("#tblSchedules").DataTable({
                "ordering": true,
                order: [[0, 'desc']],
                "responsive": true,
                columnDefs: [{targets: 0,type: 'date'}]
            })
        });
    });
    function RemoveSch(id, btn) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.get("/Session/RemoveSch?id=" + id).done(function(data) {
                    btn.closest("tr").remove();
                    Swal.fire({
                        title: "Deleted!",
                        text: "Record has been deleted.",
                        icon: "success"
                    });
                });
            }
        });
    }
</script>
