@using EHUB.Utilities
@using System.Data
@{
    ViewData["Title"] = "Designations/Line Managers";
    ViewData["pgHeader"] = "Add/Modify Departments & Line Manager Assignment";
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
}
<style type="text/css">
    .btnsh {
        opacity: 0;
    }
    tr:hover .btnsh {
        opacity: 1;
    }

    .select2-container--default .select2-results__group {
        cursor: default;
        display: block;
        padding: 6px;
        background: #e5e5e5;
        color: #2a327d;
    }
</style>
<section class="content">
    @if (chk != "r" || chk != "")
    {
        <div class="row">
            <div class="col-md-6" style="margin-bottom: 10px;">
                <a id="btnAdd" class="btn btn-primary"><i class="fa-solid fa-user-tie"></i> Add New Designations</a>
            </div>
            <div class="col-md-6" style="margin-bottom: 10px;">
                <a id="btnAssign" class="btn btn-primary"><i class="fa-solid fa-solid fa-clipboard-user"></i> Line Manager Assignment</a>
            </div>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table id="tbLoc" class="table table-hover table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Designations</th>
                            </tr>
                        </thead>
                        <tbody id="tblLoc">
                            @foreach (DataRow item in Model.design)
                            {
                                <tr>
                                    <td>
                                        @item["Designation"]
                                        <span class="btnsh">
                                            @if (chk == "f")
                                            {
                                                <a onclick="DelDesig(@item["Id"])" class="btn-del btn btn-outline-danger btn-xs float-right" style="margin-left: 5px;"><i class="fa-solid fa-times"></i> Remove</a>
                                           

                                                <a onclick="Edit('@item["Designation"]',@item["Id"])" class="btn btn-outline-success btn-xs float-right"><i class="fa-solid fa-pen"></i> Edit</a>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="dgAdd" style="display: none;">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add/Modify Designations</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="frmAdd" class="" method="post" asp-controller="Administration" asp-action="Designations" enctype="multipart/form-data">
                <div class="modal-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-12">
                                    <input type="hidden" value="0" id="Id" name="Id" class="frm" />
                                    <label>Designation</label>
                                    <input type="text" class="form-control frm" name="Designation" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-fw fa fa-save"></i>&nbsp;Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="dgAssign" style="display: none;">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Line Manager Assignment</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="frmAssign" class="" method="post" asp-controller="Administration" asp-action="ManagerAssignment" enctype="multipart/form-data">
                <div class="modal-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group clearfix">
                                        <input type="hidden" id="Mode" name="mode" value="1" />
                                        <div class="icheck-orange d-inline rd-opt">
                                            <input type="radio" id="optDepart" name="optD" value="1" checked class="optMode">
                                            <label for="optDepart">
                                                By Department
                                            </label>
                                        </div>
                                        <div class="icheck-orange d-inline rd-opt">
                                            <input type="radio" id="optEmp" name="optD" value="2" class="optMode">
                                            <label for="optEmp">
                                                By Employees
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 staff" style="display: none;">
                                    <label for="">Staff</label>
                                    <select name="EmpIds[]" id="staffid" class="form-control select2" multiple="multiple" style="width:100%">
                                        @foreach (var item in Model.staff)
                                        {
                                            <option value="@item.empid">@item.empcode - @item.empname</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-12 depart">
                                    <label for="">Department</label>
                                    <select name="DepartIds[]" id="departid" class="form-control select2" multiple="multiple" style="width:100%">
                                        @foreach (var d in Model.departs)
                                        {
                                            <optgroup label="@d.Depart"></optgroup>
                                            @foreach (var item in d.SubDepartments)
                                            {
                                                <option value="@item.DepartID">@item.Depart</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label>Line Manager</label>
                                            <select name="MgrId" class="form-control select2" style="width:100%">
                                                @foreach (var item in Model.staff)
                                                {
                                                    <option value="@item.empid">@item.empcode - @item.empname</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-fw fa fa-save"></i>&nbsp;Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">
        $('#btnAssign').on('click', function () {
        $('.frm').val('');
        $('#dgAssign').modal("show");
    });
    $(".optMode").on('change', function (e) {
        $("#Mode").val($(this).val());
        if ($("#Mode").val() == "1") {
            $(".staff").hide();
            $(".depart").show();
        }
        else {
            $(".staff").show();
            $(".depart").hide();
        }
    });
    $('#btnAdd').on('click', function () {
        $('.frm').val('');
        $('#dgAdd').modal("show");
    });
    function Edit(Designation, Id) {
        $('.frm').val('');
        $('[name=Id]').val(Id);
        $('[name=Designation]').val(Designation);
        $('#dgAdd').modal("show");
    }
        function DelDesig(id){
                Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.get("/Administration/DelDesig?id=" + id).done(function (data) {

                    Swal.fire({
                        title: "Deleted!",
                        text: "Record has been deleted.",
                        icon: "success"
                    });
                    location.href = "";
                });
            }
        });
    }
</script>