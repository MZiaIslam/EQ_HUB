@using EHUB.Utilities
@using System.Data
@{
    ViewData["Title"] = "Departments";
    ViewData["pgHeader"] = "Add/Modify Departments";
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
}
<style type="text/css">
    .btnsh {
        opacity: 0;
    }
    tr:hover .btnsh {
        opacity: 1;
    }
</style>
<section class="content">
    @if (chk != "r" || chk != "")
    {
        <div class="col-md-6" style="margin-bottom: 10px;">
            <a id="btnAdd" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Department</a>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table id="tbDepart" class="table table-hover table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Parent Department</th>
                                <th>Department Head</th>
                            </tr>
                        </thead>
                        <tbody id="tblDprt">
                            @foreach (DataRow item in Model[3])
                            {
                                <tr>
                                    <td>@item["Depart"]</td>
                                    <td>
                                        @item["FName"] @item["LName"]
                                        <span class="btnsh">
                                            @if (chk == "f")
                                            {
                                                <a onclick="DelHead(@item["DepartID"])" class="btn btn-outline-danger btn-xs float-right" style="margin-left: 5px;"><i class="fa-solid fa-times"></i> Remove</a>
                                                <a onclick="Edit('@item["Depart"]','@item["ParentId"]','@item["HeadEmp"]',@item["DepartID"])" class="btn btn-outline-success btn-xs float-right"><i class="fa-solid fa-pen"></i> Edit</a>
                                                
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table id="tbDepart" class="table table-hover table-striped table-sm">
                        <thead>
                            <tr>
                        
                                <th>Department</th>
                                <th>Department Head</th>
                            </tr>
                        </thead>
                        <tbody id="tblDprt">
                            @foreach (DataRow item in Model[2])
                            {
                                <tr>

                                    <td>
                                        <span class="badge badge-success">@item["dHead"]</span> 
                                        @item["Depart"]</td>
                                    <td>
                                        @item["FName"] @item["LName"]
                                        <span class="btnsh">
                                            @if (chk == "f")
                                            {

                                                <a onclick="DelHead(@item["DepartID"])" class="btn btn-outline-danger btn-xs float-right" style="margin-left: 5px;"><i class="fa-solid fa-times"></i> Remove</a>
                                                <a onclick="Edit('@item["Depart"]','@item["ParentId"]','@item["HeadEmp"]',@item["DepartID"])" class="btn btn-outline-success btn-xs float-right"><i class="fa-solid fa-pen"></i> Edit</a>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="dgAdd" style="display: none;">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add/Modify Department</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="frmAdd" class="" method="post" asp-controller="Administration" asp-action="Departments" enctype="multipart/form-data">
                <div class="modal-body table-responsive">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="col-md-12">
                                    <input type="hidden" value="0" id="DepartID" name="DepartID" class="frm" />
                                    <label>Departments</label>
                                    <input type="text" class="form-control frm" name="Depart" />
                                </div>
                                <div class="col-md-12">
                                    <label for="">Departments Head</label>
                                    <select name="HeadEmp" id="staffid" class="form-control select2" style="width:100%">
                                        <option value="">N/A</option>
                                        @foreach (var item in Model[0])
                                        {
                                            <option value="@item.empid">@item.empcode - @item.empname</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <label for="">Parent Department</label>
                                    <select name="ParentId" id="departid" class="form-control select2" style="width:100%">
                                        @foreach (DataRow item in Model[1])
                                        {
                                            <option value="@item["DepartID"]">@item["Depart"]</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-fw fa fa-save"></i>&nbsp;Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('#btnAdd').on('click', function () {
        $('.frm').val('');
        $('#dgAdd').modal("show");
    });
    function DelHead(id){

                Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.get("/Administration/DelHead?id=" + id).done(function (ct) {
                       if(ct>0){
                           Swal.fire({
                        title: "Not-Deleted!",
                        text: "Department is in use. Please eliminate the department or assign another head before you can delete this one.",
                        icon: "error"
                    });
                 
               }else{
    Swal.fire({
                            title: "Deleted!",
                            text: "Record has been deleted.",
                            icon: "success"
                        });
                        location.href = "";
               }
                    
                });
            }
        });
             

    }
    function Edit(Depart, ParentId, HeadEmp, DepartID) {
        $('.frm').val('');
        $('[name=DepartID]').val(DepartID);
        $('[name=Depart]').val(Depart);
        $('#staffid').val(HeadEmp).trigger('change');
        $('#departid').val(ParentId).trigger('change');
        $('#dgAdd').modal("show");
    }
</script>