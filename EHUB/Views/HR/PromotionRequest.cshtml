@{
	ViewData["Title"] = "Promotion Request";
	ViewData["pgHeader"] = "Staff Promotion Request";
}
<style type="text/css">

	.ft16 {
		font-size: 14px;
	}
	.rd-opt{
		float:left;
		padding-right: 12px;
	}


</style>
<section class="content">
	<div class="card">
		<div class="card-body">
			<form asp-controller="HR" asp-action="PromotionRequest" enctype="multipart/form-data" method="post">
				<div class="row">
					<div class="col-md-4">
						<div class="row">
							
							<div class="col-md-6">
								<label for="">Request Date</label>
								<input type="date" id="dtRequest" name="dtRequest" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required="required">
							</div>
                            <div class="col-md-12">
                                <label for="">Staff Name</label>
								<select name="EmpId" id="EmpId" class="form-control select2" width="100%">
									@foreach (var item in Model.ddEmplist)
                                    {
										<option value="@item.EmpID" tag="@item.Designation">@item.EmpCode - @item.FName @item.LName</option>
                                    }
                                </select>
                            </div>
							<div class="col-md-12">
								<label >Designation</label>
								<span class="form-control" id="txtDesig"></span>
								<select name="FrmId" id="FrmId" class="form-control" style="display: none;">
									@foreach (var item in Model.designations)
									{
										<option value="@item.Id" >@item.Designation</option>
									}
								</select>
							
							</div>
							<div class="col-md-12">
								<label for="">Promote To</label>
								<select name="ToId" id="ToId" class="form-control select2">
									@foreach (var item in Model.designations)
									{
										<option value="@item.Id">@item.Designation</option>
									}
								</select>
							</div>
						
						
					
							<div class="col-md-12">
								<label>Description</label>
								<textarea name="RqDesc" class="form-control" rows="3"></textarea>
							</div>
						
							<div class="col-md-12">
								<br />
								<button type="submit" class="btn btn-primary"><i class="fa-solid fa-file"></i> Post Request</button>
							</div>
						</div>
					</div>
					<div class="col-md-8">
						
							<div class="card-header">
							<h3 class="card-title" style="font-size: 24px;font-variant-caps: petite-caps;color: #fd7e14;">Recent Promotion Request</h3>
							</div>
						
								<table class="table table-striped table-hover collapsed" id="tbleaves">
									<thead>
										<tr>
											<th>Request Date</th>
									<th>Staff Name</th>
									<th>Designation</th>
									<th>Promote To</th>
											
									<th>Request By</th>
									<th>Request Status</th>
											<th>Description</th>
										</tr>
									</thead>
									<tbody>
								@foreach (var item in Model.generalrequest)
										{
											<tr>
										<td>@item.dtrequest.ToString("dd MMM yyyy")</td>
										<td>@item.rqstfor</td>
										<td>@item.frmSt</td>
                                        <td>@item.toSt</td>
										
										<td>@item.rqstby</td>
										<td title="@item.aprvby">
													@{
														if (item.aprvstatus == "To Approve")
														{
																			<span class="badge bg-primary ft16">To Approve</span>
														}
														else if (item.aprvstatus == "Approved")
														{
																			<span class="badge bg-success ft16">Approved</span>
														}
														else if (item.aprvstatus == "Refused")
														{
																			<span class="badge bg-danger ft16">Refused</span>
														}
													}
												</td>
												<td>
									
											@item.RqDesc
												</td>
											</tr>
										}
									</tbody>
								</table>
							
						
					</div>
				</div>
			</form>
		</div>
	</div>
</section>
<script type="text/javascript">
	function getNumberOfDays(start, end) {
		const date1 = new Date(start);
		const date2 = new Date(end);
		// One day in milliseconds
		const oneDay = 1000 * 60 * 60 * 24;
		// Calculating the time difference between two dates
		const diffInTime = date2.getTime() - date1.getTime();
		// Calculating the number of days between two dates
		const diffInDays = Math.round(diffInTime / oneDay);
		return (diffInDays + 1) + " day(s)";
	}
	$(document).ready(function () {
		
		
		$("#EmpId").on('change', function (e) {
			console.log($(this).attr("tag"))
			$("#FrmId").val($("#EmpId :selected").attr("tag")); 
			$("#txtDesig").html($("#FrmId :selected").text());
		});

		$("#EmpId").trigger('change');



		$("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
		$(function () {
			$("#tbleaves").DataTable({
				"ordering": true,
				"responsive": true,
			})
		});
	});
	$("#dtFrom, #dtTo").on('change', function (e) {
		$("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
	});
	$(".optDuration").on('change', function (e) {
		$("#lvD").val($(this).val());
		if ($("#lvD").val() == "2") {
			$(".todate").hide();
			$("#Duration").html("0.5 Day");
	
		}
		else if ($("#lvD").val() == 3) {
			$(".todate").hide();
			$("#Duration").html("0.25 Day");
		}
		else {
			$(".todate").show();
			$("#Duration").html(getNumberOfDays($("#dtFrom").val(), $("#dtTo").val()));
		}
	});
</script>
