@using EHUB.Utilities
@{
    ViewData["Title"] = "Request Approvals";
    ViewData["pgHeader"] = "Pending Approval Requests";
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
}
<style type="text/css">
    .btnsh {
        opacity: 0;
        display: none;
    }

    tr:hover .btnsh {
        opacity: 1;
        display: inline;
    }

    .dropdown-item:hover .btnsh {
        opacity: 1;
        display: inline;
    }

    .ft16 {
        font-size: 14px;
    }
</style>
<section class="content">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav nav-tabs">
                        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#TransferRequest"><i class="fas fa-solid fa-shuffle nav-icon "></i> Transfer Requests</a></li>
                        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#PromotionRequest"><i class="fas fa-solid fa-person-military-to-person nav-icon "></i> Promotion Requests</a></li>
                        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#ExemptionRequests"><i class="fas fa-solid fa-file-circle-check nav-icon "></i> Exemption Requests</a></li>
                    </ul>
                    <div class="tab-content">
                        <div id="TransferRequest" class="tab-pane fade in active show">
                            <table class="table table-striped table-hover" id="tbleaves">
                                <thead>
                                    <tr>
                                        <th>Request Date</th>
                                        <th>Staff Name</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Request By</th>
                                        <th>Request Status</th>
                                        <th style="min-width:160px">Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.generalrequest)
                                    {
                                        @if (item.RqType == "Transfer Request")
                                        {
                                            <tr>
                                                <td>@item.dtrequest.ToString("dd MMM yyyy")</td>
                                                <td>@item.rqstfor</td>
                                                <td>@item.frmSt</td>
                                                <td>@item.toSt</td>
                                                <td>@item.rqstby</td>
                                                <td title="@item.aprvby">
                                                    @{
                                                        if (item.aprvstatus == "To Approve")
                                                        {
                                                            <span class="badge bg-primary ft16">To Approve</span>
                                                        }
                                                        else if (item.aprvstatus == "Approved")
                                                        {
                                                            <span class="badge bg-success ft16">Approved</span>
                                                        }
                                                        else if (item.aprvstatus == "Refused")
                                                        {
                                                            <span class="badge bg-danger ft16">Refused</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @item.RqDesc
                                                    <span class="btnsh float-right">
                                                        @if (item.aprvstatus == "To Approve")
                                                        {
                                                            <a class="btn btn-outline-danger btn-xs" asp-controller="HR" asp-action="Refuse" asp-route-id="@item.id"><i class="fa-solid fa-times"></i> Refuse</a>
                                                            <a class="btn btn-outline-success btn-xs" asp-controller="HR" asp-action="Approve" asp-route-id="@item.id"><i class="fa-solid fa-thumbs-up fa-beat"></i> Approve</a>
                                                        }
                                                    </span>
                                                </td>
                                            </tr>
                                        }}
                                </tbody>
                            </table>
                        </div>
                        <div id="PromotionRequest" class="tab-pane fade">
                            <table class="table table-striped table-hover" id="tbleaves">
                                <thead>
                                    <tr>
                                        <th>Request Date</th>
                                        <th>Staff Name</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Request By</th>
                                        <th>Request Status</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.generalrequest)
                                    {@if (item.RqType == "Promotion Request")
                                        {
                                            <tr>
                                                <td>@item.dtrequest.ToString("dd MMM yyyy")</td>
                                                <td>@item.rqstfor</td>
                                                <td>@item.frmSt</td>
                                                <td>@item.toSt</td>
                                                <td>@item.rqstby</td>
                                                <td title="@item.aprvby">
                                                    @{
                                                        if (item.aprvstatus == "To Approve")
                                                        {
                                                            <span class="badge bg-primary ft16">To Approve</span>
                                                        }
                                                        else if (item.aprvstatus == "Approved")
                                                        {
                                                            <span class="badge bg-success ft16">Approved</span>
                                                        }
                                                        else if (item.aprvstatus == "Refused")
                                                        {
                                                            <span class="badge bg-danger ft16">Refused</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @item.RqDesc
                                                    <span class="btnsh float-right">
                                                        @if (item.aprvstatus == "To Approve")
                                                        {
                                                            <a class="btn btn-outline-danger btn-xs" asp-controller="HR" asp-action="Refuse" asp-route-id="@item.id"><i class="fa-solid fa-times"></i> Refuse</a>
                                                            <a class="btn btn-outline-success btn-xs" asp-controller="HR" asp-action="Approve" asp-route-id="@item.id"><i class="fa-solid fa-thumbs-up fa-beat"></i> Approve</a>
                                                        }
                                                    </span>
                                                </td>
                                            </tr>
                                        }}
                                </tbody>
                            </table>
                        </div>
                        <div id="ExemptionRequests" class="tab-pane fade">
                            <table class="table table-striped table-hover" id="tbleaves">
                                <thead>
                                    <tr>
                                        <th>Exemption Date</th>
                                        <th>Staff Name</th>
                                        <th>Exemption Type</th>
                                        <th>Flag Type</th>
                                        <th>Created</th>
                                        <th>Request Status</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.excptRequests)
                                    {
                                        <tr>
                                            <td>@item.dtExem.ToString("dd MMM yyyy")</td>
                                            <td>@item.EmpCode @item.FName @item.LName</td>
                                            <td>@item.ExemType</td>
                                            <td>@item.FlagType</td>
                                            <td>@item.Created</td>
                                            <td title="@item.aprvfname @item.aprvlname">
                                                @{
                                                    if (item.aprvstatus == "To Approve")
                                                    {
                                                        <span class="badge bg-primary ft16">To Approve</span>
                                                    }
                                                    else if (item.aprvstatus == "Approved")
                                                    {
                                                        <span class="badge bg-success ft16">Approved</span>
                                                    }
                                                    else if (item.aprvstatus == "Refused")
                                                    {
                                                        <span class="badge bg-danger ft16">Refused</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @item.Remarks
                                                <span class="btnsh float-right">
                                                    @if (item.aprvstatus == "To Approve")
                                                    {
                                                        <a class="btn btn-outline-danger btn-xs" asp-controller="HR" asp-action="ExpRefuse" asp-route-id="@item.Id"><i class="fa-solid fa-times"></i> Refuse</a>
                                                        <a class="btn btn-outline-success btn-xs" asp-controller="HR" asp-action="ExpApprove" asp-route-id="@item.Id"><i class="fa-solid fa-thumbs-up fa-beat"></i> Approve</a>
                                                    }
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">
    $(document).ready(function () {
        $(function () {
            $("#tbleaves").DataTable({
                "ordering": true,
                "responsive": true,
            })
        });
    });
</script>
