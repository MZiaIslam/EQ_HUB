@using Newtonsoft.Json
@using EHUB.Utilities
@{
    ViewData["Title"] = "Staff Registration";
    ViewData["pgHeader"] = "Staff Profile";
    var uinfo = User.Claims.ToArray();
    AuthRights authRights = new AuthRights();
    var chk = authRights.chk();
    var mgr = authRights.mgr();
    var lck = "lck";
    @if (chk == "f")
    {
        lck = "";
    }
}
<style type="text/css">
    .select2-container--default .select2-results__group {
        cursor: default;
        display: block;
        padding: 6px;
        background: #e5e5e5;
        color: #2a327d;
    }

    .btnsh {
        opacity: 0;
    }

    tr:hover .btnsh {
        opacity: 1;
    }

    .lck {
        pointer-events: none;
    }
</style>
<section class="content">
    <div class="card">
        <div class="card-body">
            <form asp-controller="HR" asp-action="EditStaff" enctype="multipart/form-data" method="post">
                <div class="row">
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            PERSONAL DETAIL
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <p class="mb-1" style="color: red;font-size: small;">
                                @TempData["msg"]
                            </p>
                            <div class="col-md-10">
                                <div class="row">
                                    <div class="col-md-3">
                                        <label>Employee ID <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                        <input type="number" name="EmpID" id="EmpID" value="@Model.emp.EmpID" class="form-control  @lck" hidden>
                                        <input type="number" value="@Model.emp.EmpCode" name="EmpCode" class="form-control  @lck" required="required">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">First Name <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                        <input type="text" value="@Model.emp.FName" name="FName" class="form-control @lck" required="required">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Last Name</label>
                                        <input type="text" name="LName" value="@Model.emp.LName" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Father Name</label>
                                        <input type="text" value="@Model.emp.FatherName" name="FatherName" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Mobile #</label>
                                        <input type="text" name="MobileNo" value="@Model.emp.MobileNo" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Email <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                        <input type="text" name="Email" value="@Model.emp.Email" id="txtEmil" class="form-control @lck" required="required">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Gender</label>
                                        <select name="Gender" id="GenderID" class="form-control @lck">
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Date of Birth</label>
                                        <input type="date" value="@(Model.emp.DateOfBirth==null?"":Model.emp.DateOfBirth.ToString("yyyy-MM-dd"))" name="DateOfBirth" class="form-control @lck" />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">CNIC #</label>
                                        <input type="text" value="@Model.emp.CnicNo" data-inputmask="'mask': '99999-9999999-9'" name="CnicNo" maxlength="15" class="form-control @lck" placeholder="99999-9999999-9">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">CNIC Expiry Date</label>
                                        <input type="date" value="@(Model.emp.CnicExpiry==null?"":Model.emp.CnicExpiry.ToString("yyyy-MM-dd"))" name="CnicExpiry" class="form-control @lck">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label>Photo</label>        <div class="clearfix">
                                </div>
                                <img id="imgStaff" src="~/dist/img/staffdata/pics/@(Model.emp.EmpID).png" onerror="this.onerror=null;this.src='/dist/img/StaffData/pics/usr.png'" style="height: 100px;">
                                <input type="file" name="photo" id="StaffPic" class="" accept="image/png, image/jpeg" style="display: none;">
                                <h3></h3>
                                <label for="StaffPic" class="btn btn-primary btn-xs">
                                    Upload Image
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            PRIVATE CONTACT
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-10">
                                <div class="row">
                                    <div class="col-md-3">
                                        <label for="">Marital Status</label>
                                        <select id="MaritalID" name="Marital" class="form-control @lck">
                                            <option value="Single">Single</option>
                                            <option value="Married">Married</option>
                                            <option value="Divorced">Divorced</option>
                                            <option value="Widowed">Widowed</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Religion</label>
                                        <select name="Religion" id="ReligionID" class="form-control @lck">
                                            <option value="Islam">Islam</option>
                                            <option value="Christianity">Christianity</option>
                                            <option value="Hinduism">Hinduism</option>
                                            <option value="Sikhism">Sikhism</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">E.O.B.I Card No. </label>
                                        <input type="text" value="@Model.emp.EOBINo" name="EOBINo" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">E.O.B.I Reg. Date</label>
                                        <input type="date" value="@(Model.emp.EOBIReg==null?"":Model.emp.EOBIReg.ToString("yyyy-MM-dd"))" name="EOBIReg" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">Social Security #</label>
                                        <input type="text" value="@Model.emp.SocialSecurity" name="SocialSecurity" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">City</label>
                                        <select name="City" class="form-control @lck">
                                            @foreach (var item in Model.loc)
                                            {
                                                if (Model.emp != null && Model.emp.City == item.LocId)
                                                {
                                                    <option selected value="@item.LocId">@item.Loc</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.LocId">@item.Loc</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-10">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label>Temporary Address</label>
                                        <textarea name="Address" class="form-control @lck" rows="3">@Model.emp.Address</textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Permanent Address</label>
                                        <textarea name="permanentaddress" class="form-control @lck" rows="3">@Model.emp.permanentaddress</textarea>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">
                                            Contact Person
                                        </label>
                                        <input value="@Model.emp.ContactPerson" type="text" name="ContactPerson" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">
                                            Relationship
                                        </label>
                                        <input value="@Model.emp.Relationship" type="text" name="Relationship" class="form-control @lck">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="">
                                            Contact No.
                                        </label>
                                        <input value="@Model.emp.ContactNo" type="text" name="ContactNo" class="form-control @lck">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            EMPLOYMENT DETAILS
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Unit/Branch</label>
                                    <select id="cboStation" name="Station" class="form-control  @lck">
                                        @foreach (var item in Model.stations)
                                        {
                                            <option value="@item.StationID">@item.Station</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Department <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                    <select name="Department" id="Department" class="form-control  @lck" required="required">
                                        @foreach (var d in Model.departs)
                                        {
                                            <optgroup label="@d.Depart"></optgroup>
                                            @foreach (var item in d.SubDepartments)
                                            {
                                                <option value="@item.DepartID">@item.Depart</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Designation <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                    <select name="Designation" id="cboDesig" class="form-control  @lck" required="required">
                                        @foreach (var item in Model.desig)
                                        {
                                            <option value="@item.Id">@item.Designation</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Line Manager <i class="fa-thin fa-asterisk fa-beat-fade fa-lg" style="color: #f00000;"></i></label>
                                    <select name="RManager" id="cboRManager" class="form-control  @lck" required="required">
                                        @foreach (var item in Model.linemgr)
                                        {
                                            <option value="@item.empid">@item.empname</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-8">
                                    <label for="">Joining Date</label>
                                    <input value="@(Model.emp.JoiningDate==null?"":Model.emp.JoiningDate.ToString("yyyy-MM-dd"))" type="date" name="JoiningDate" class="form-control @lck " />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-8">
                                    <label for="">Employee Status</label>
                                    <select name="JobStatus" id="cboJobStatus" class="form-control  @lck" required="required">
                                        @foreach (var item in Model.jobstatus)
                                        {
                                            <option value="@item.Id">@item.EmployeeStatus</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-8">
                                    <label for="">Confirmation Date</label>
                                    <input value="@(Model.emp.ConfirmationDate==null?"":Model.emp.ConfirmationDate.ToString("yyyy-MM-dd"))" type="date" name="ConfirmationDate" class="form-control @lck" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-8">
                                    <label for="">Expected Confirmation Days</label>
                                    <input type="number" value="@Model.emp.ConfirmationDay" name="ConfirmationDay" class="form-control @lck" style="max-width: 100px;" />
                                </div>
                            </div>
                            @* 		<div class="col-md-4">
								<div class="row">
									<div class="col-md-6">
										<label for="">Allow Manual Attendance</label>
										<select name="ManualAttendance" id="ManualAtt" class="form-control">
											<option value="0">No</option>
											<option value="1">Yes</option>
										</select>
									</div>
									<div class="col-md-6">
										<label for="">On Device Attendance</label>
										<select name="isAtt" id="isAtt" class="form-control">
											<option value="0">No</option>
											<option value="1">Yes</option>
										</select>
									</div>
								</div>
							</div> *@
                            <div class="col-md-12" style="border: solid 1px;margin: 15px;color: aliceblue;">
                                <div class="clearfix">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <label for="">Allow Web Login</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">
                                                <input type="checkbox" value="@(Model.emp.WebLogin)" id="WebLogin" checked="@(Model.emp.WebLogin==1?true:false)" name="WebLogin" onchange="WebChk(this)">
                                            </span>
                                        </div>
                                        <span id="txtLogin" type="text" class="form-control @lck">@Model.emp.Email</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <label for="">User Group</label>
                                    <select name="GroupID" id="Grp" class="form-control  @lck" @(Model.emp.WebLogin == 1 ? "" : "disabled")>
                                        @foreach (var item in Model.usergroups)
                                        {
                                            <option value="@item.GroupID">@item.GroupName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <label for="">User Password</label>
                                    <input name="Password" value="@Model.emp.Password" id="txtPass" type="password" class="form-control @lck" @(Model.emp.WebLogin == 1 ? "" : "disabled")>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            BANK INFORMATION
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Account Title</label>
                                    <input type="text" value="@Model.emp.ACTitle" name="ACTitle" id="txtACTitle" class="form-control @lck">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Account Number</label>
                                    <input type="text" value="@Model.emp.BankAccount" name="BankAccount" id="department" class="form-control @lck">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-10">
                                    <label for="">Bank Name</label>
                                    <select name="Bank" id="Bank" class="form-control  @lck">
                                        <option value="Al Baraka Bank (Pakistan) Limited">Al Baraka Bank (Pakistan) Limited</option>
                                        <option value="Allied Bank Limited (ABL)">Allied Bank Limited (ABL)</option>
                                        <option value="Askari Bank">Askari Bank</option>
                                        <option value="Bank Alfalah Limited (BAFL)">Bank Alfalah Limited (BAFL)</option>
                                        <option value="Bank Al-Habib Limited (BAHL)">Bank Al-Habib Limited (BAHL)</option>
                                        <option value="BankIslami Pakistan Limited">BankIslami Pakistan Limited</option>
                                        <option value="Bank Makramah Limited (BML)">Bank Makramah Limited (BML)</option>
                                        <option value="Bank of Punjab (BOP)">Bank of Punjab (BOP)</option>
                                        <option value="Bank of Khyber">Bank of Khyber</option>
                                        <option value="Deutsche Bank A">Deutsche Bank A</option>
                                        <option value="Dubai Islamic Bank Pakistan Limited (DIB Pakistan)">Dubai Islamic Bank Pakistan Limited (DIB Pakistan)</option>
                                        <option value="Faysal Bank Limited (FBL)">Faysal Bank Limited (FBL)</option>
                                        <option value="First Women Bank Limited">First Women Bank Limited</option>
                                        <option value="Habib Bank Limited (HBL)">Habib Bank Limited (HBL)</option>
                                        <option value="Habib Metropolitan Bank Limited">Habib Metropolitan Bank Limited</option>
                                        <option value="Industrial and Commercial Bank of China">Industrial and Commercial Bank of China</option>
                                        <option value="Industrial Development Bank of Pakistan">Industrial Development Bank of Pakistan</option>
                                        <option value="JS Bank Limited">JS Bank Limited</option>
                                        <option value="MCB Bank Limited">MCB Bank Limited</option>
                                        <option value="MCB Islamic Bank Limited">MCB Islamic Bank Limited</option>
                                        <option value="Meezan Bank Limited">Meezan Bank Limited</option>
                                        <option value="National Bank of Pakistan (NBP)">National Bank of Pakistan (NBP)</option>
                                        <option value="Soneri Bank Limited">Soneri Bank Limited</option>
                                        <option value="Standard Chartered Bank (Pakistan) Limited (SC Pakistan)">Standard Chartered Bank (Pakistan) Limited (SC Pakistan)</option>
                                        <option value="Sindh Bank">Sindh Bank</option>
                                        <option value="The Bank of Tokyo-Mitsubishi UFJ (MUFG Bank Pakistan)">The Bank of Tokyo-Mitsubishi UFJ (MUFG Bank Pakistan)</option>
                                        <option value="United Bank Limited (UBL)">United Bank Limited (UBL)</option>
                                        <option value="Zarai Taraqiati Bank Limited">Zarai Taraqiati Bank Limited</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <label for="">Branch Name & Address</label>
                                    <textarea name="BranchCode" class="form-control @lck" rows="3">@Model.emp.BranchCode</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            NOTE
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <label for="">Note/Remarks</label>
                                    <textarea name="remarks" class="form-control @lck" rows="3">@Model.emp.remarks</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    @* 					<div class="col-12" style="padding-left: 48px;">
						<button type="submit" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Save Record</button>
					</div> *@
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            ACADEMIC INFO.
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Qualification</th>
                                                <th>Institute/University</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tblEdu">
                                            @foreach (var item in Model.staffedus)
                                            {
                                                <tr><td>@item.qualification</td><td>@item.institute</td><td>@item.description<span class='btnsh float-right'><a r-data="@(JsonConvert.SerializeObject(item))" class="btn-edu btn btn-outline-warning btn-xs"><i class="fa-solid fa-edit fa-beat"></i> Edit</a> <a onclick="DelEdu(@(item.id))" class="btn btn-outline-danger btn-xs"><i class="fa-solid fa-trash fa-beat"></i> Delete</a></span></td></tr>
                                            }
                                        </tbody>
                                        <tfoot><tr><td colspan="3"><a id="btnEdu" class="btn btn-outline-warning btn-xs"><i class="fa-solid fa-user-plus"></i> Add Education</a></td></tr></tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            WORK HISTORY
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Job Field</th>
                                                <th>Organisation</th>
                                                <th>Duration</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tblWorkHis">
                                            @foreach (var item in Model.workhist)
                                            {
                                                <tr><td>@item.jobfield</td><td>@item.organisation</td><td>@item.duration</td><td>@item.description<span class='btnsh float-right'><a r-data="@(JsonConvert.SerializeObject(item))" class="btn-work btn btn-outline-warning btn-xs"><i class="fa-solid fa-edit fa-beat"></i> Edit</a> <a onclick="DelWork(@(item.id))" class="btn btn-outline-danger btn-xs"><i class="fa-solid fa-trash fa-beat"></i> Delete</a></span></td></tr>
                                            }
                                        </tbody>
                                        <tfoot><tr><td colspan="4"><a id="btnWork" class="btn btn-outline-warning btn-xs"><i class="fa-solid fa-user-plus"></i> Add Resume</a></td></tr></tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12" style="padding-top: 36px;">
                        <div class="clearfix">
                        </div>
                    </div>
                    <div class="col-1" style="flex: 0 0 0.333333%;writing-mode: vertical-lr;text-align: center;background: aliceblue;color: #2a327d;font-size: 20px;padding:0;">
                        <span>
                            DOCUMENTS
                        </span>
                    </div>
                    <div class="col-11">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Document Title</th>
                                                <th>Type</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tblStaffDocs">
                                            @foreach (var item in Model.staffdocs)
                                            {
                                                <tr><td><a href="~/dist/img/staffdata/docs/@item.docname">@item.title</a></td><td>@item.type<span class='btnsh float-right'><a onclick="DelDoc(@(item.id))" class="btn btn-outline-danger btn-xs"><i class="fa-solid fa-trash fa-beat"></i> Delete</a></span></td></tr>
                                            }
                                        </tbody>
                                        <tfoot><tr><td colspan="2"><a id="btnAttach" class="btn btn-outline-warning btn-xs"><i class="fa-solid fa-user-plus"></i> Attach Document</a></td></tr></tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
