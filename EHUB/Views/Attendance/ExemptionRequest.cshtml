@{
	ViewData["Title"] = "Exemption Request";
	ViewData["pgHeader"] = "Exemption Request";
}
<style type="text/css">
	.ft16 {
		font-size: 14px;
	}
	.rd-opt {
		float: left;
		padding-right: 12px;
	}
</style>
<section class="content">
	<div class="card">
		<div class="card-body">
				<div class="row">
					<div class="col-md-4">
<form asp-controller="Attendance" asp-action="ExemptionRequest" enctype="multipart/form-data" method="post">
						<div class="row">
							<div class="col-md-12" hidden>
								<label for="">Staff</label>
								<select name="EmpId" id="staffid" class="form-control select2" style="width:100%" required="required">
									@foreach (var item in Model.staff)
									{
										<option value="@item.empid">@item.empcode - @item.empname</option>
									}
								</select>
							</div>
							<div class="col-md-12">
								<div class="row">
									<div class="col-md-6">
										<label>Date</label>
										<input type="date" id="dtRequest" name="dtExem" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required="required">
									</div>
									<div class="col-md-6">
										<label for="">Flag Type</label>
										<select name="FlagType" id="FlagType" class="form-control" required="required">
										</select>
									</div>
								</div>
							</div>
							<div class="col-md-12">
								<label for="">Exemption Type</label>
								<select name="ExemType" id="ExemType" class="form-control" required="required">
								</select>
							</div>
							<div class="col-md-12">
								<label>Description</label>
								<textarea name="Remarks" class="form-control" rows="3"></textarea>
							</div>
							<div class="col-md-12">
								<br />
								<button type="submit" class="btn btn-primary"><i class="fa-solid fa-file"></i> Post Request</button>
							</div>
						</div>	
						</form>
					</div>
					<div class="col-md-8">
						<div class="card-header">
							<h3 class="card-title" style="font-size: 24px;font-variant-caps: petite-caps;color: #fd7e14;">Recent Exemption Requests</h3>
						</div>
						<table class="table table-striped table-hover collapsed" id="tbleaves">
							<thead>
								<tr>
									<th>Request Date</th>
									<th>Flag Type</th>
									<th>Exemption Type</th>
									<th>Request Status</th>
									<th>Description</th>
								</tr>
							</thead>
							<tbody>
							@foreach (var item in Model.exemptRqst)
							{
							<tr>
							<td>@item.dtExem.ToString("dd MMM yyyy")</td>
							<td>@item.FlagType</td>
							<td>@item.ExemType</td>
							<td>
							@{
							if (item.aprvstatus == "To Approve")
							{
							<span class="badge bg-primary ft16">To Approve</span>
							}
							else if (item.aprvstatus == "Approved")
							{
												<span class="badge bg-success ft16">Approved</span>
											}
											else if (item.aprvstatus == "Refused")
											{
												<span class="badge bg-danger ft16">Refused</span>
											}
											else
											{
												<span class="badge bg-success ft16">@item.aprvstatus</span>
											}
										}
							</td><td>@item.Remarks</td>
							</tr>
							}
							</tbody>
						</table>
					</div>
				</div>
		</div>
	</div>
</section>
<script type="text/javascript">
	$(document).ready(function () {
		   getFlags($("#dtRequest").val(), $("#staffid").val());
		   getExemptDays();
		   $(function () {
				  $("#tbleaves").DataTable({
						 "ordering": true,
						 "responsive": true,
				  })
		   });
	});
	$("#dtRequest, #staffid").on('change', function (e) {
		 getFlags($("#dtRequest").val(), $("#staffid").val());
	});
	function getFlags(date, staff) {
		 let opts="";
			 $.get("/Attendance/Flags?dt=" + date+"&staff="+staff).done(function (data) {
$.each(JSON.parse(data),function(i, item){
opts += '<option value="' + item.stat + '">' + item.stat + '</option>';
});
$("#FlagType").html(opts)
			});
		 }
			 function getExemptDays() {
		 let opts="";
			 $.get("/Attendance/ExemptDays").done(function (data) {
$.each(JSON.parse(data),function(i, item){
opts += '<option value="' + item.ExemTypeId + '">' + item.ExemType + '</option>';
});
$("#ExemType").html(opts)
			});
		 }
</script>
