@{
    ViewData["Title"] = "Remote Work Request";
    ViewData["pgHeader"] = "Remote Work Request";
}
<style type="text/css">
    .ft16 {
        font-size: 14px;
    }
    .rd-opt {
        float: left;
        padding-right: 12px;
    }
</style>
<section class="content">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <form asp-controller="Attendance" asp-action="RemoteWorkRequest" enctype="multipart/form-data" method="post">
                        <div class="row">

                            <div class="col-md-12">
                                <label>Date</label>	
                                <input type="date" id="rDate" name="rDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" required="required">
                            </div>
                            <div class="col-md-6"><label>IN Time</label>	<input type="time" id="inTime" name="inTime"  class="form-control" required="required"></div>
                            <div class="col-md-6"><label>OUT Time</label>	<input type="time" id="outTime" name="outTime" class="form-control" required="required"></div>
                          
                            <div class="col-md-12">
                                <label>Reason</label>
                                <textarea name="reason" class="form-control" rows="3" required></textarea>
                            </div>
                            <div class="col-md-12">
                                <label>Supporting Document</label>        <div class="clearfix">
                                </div>
                                <input type="file" name="doc" class="" accept="image/png, image/jpeg">
                            </div>
                            <div class="col-md-12">
                                <br />
                                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-file"></i> Post Request</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-md-8">
                    <ul class="nav nav-tabs">
                        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#RWRequests"><i class="fas fa-solid fa-shuffle nav-icon "></i> RW Requests</a></li>
             
                    </ul>
                    <div class="tab-content">
                        <div id="RWRequests" class="tab-pane fade in active show">
                            <table class="table table-striped table-hover collapsed" id="tbrw">
                                <thead>
                                    <tr>
                                        <th>Request Date</th>
                                        <th>RW Date</th>
                                        <th>IN Time</th>
                                        <th>OUT Time</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                      
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Created.ToString("dd MMM yyyy")</td>
                                            <td>@item.rDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.inTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>@item.outTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>@item.reason</td>
                                         
                                        
                                            <td title="@item.Mgr">
                                                @{
                                                    if (item.aprvstatus == "To Approve")
                                                    {
                                                                <span class="badge bg-primary ft16">To Approve</span>
                                                    }
                                                    else if (item.aprvstatus == "Approved")
                                                    {
                                                                <span class="badge bg-success ft16">Approved</span>
                                                    }
                                                    else if (item.aprvstatus == "Refused")
                                                    {
                                                                <span class="badge bg-danger ft16">Refused</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    if (item.attachment != null)
                                                    {
                                                                <a href='~/dist/img/StaffData/RWRequest/@item.RWId/@item.attachment' target="_blank"><i class='fa-solid fa-paperclip'></i></a>
                                                    }
                                                }
                                               
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                   
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">

    $(document).ready(function () {

 
        $(function () {
            $("#tbrw").DataTable({
                "ordering": true,
                "responsive": true,
            })
        });
    });
</script>
