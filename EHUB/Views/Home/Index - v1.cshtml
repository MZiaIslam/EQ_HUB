				<div id="mobileAgenda" class="mobile-agenda"></div>
				@* 			<table class="calend dataTable000" id="tblCal">
					<thead>
						<tr>
							<th>SUN</th>
							<th>MON</th>
							<th>TUE</th>
							<th>WED</th>
							<th>THU</th>
							<th>FRI</th>
							<th>SAT</th>
						</tr>
					</thead>
					<tbody id="calendarBody"></tbody>
				</table> *@
			</div>
			@if (chkAdm)
			{
				<div class="row">
					<div class="col-md-12">
						<div class="card card-default">
							<div class="card-header" style="background: #2a327d;color: #fff;padding: 6px 10px 6px 6px;">
								<h3 class="card-title">Invoices Month wise</h3>
								<div class="card-tools">
									<button type="button" class="btn btn-tool prmhdr" data-card-widget="collapse">
										<i class="fas fa-minus"></i>
									</button>
								</div>
							</div>
							<div class="card-body p-0" style="display: block;">
								<div class="row">
									<div class="col-md-12" id="dvInvoices"></div>
								</div>
