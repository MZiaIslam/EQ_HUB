<script src="~/plugins/reportview/data.js"></script>
<script type="text/javascript">
	$(document).ready(function () {
		loadRpts();
		getHours();
		getInvoices();
		ScheduledSessions();
		$("#dtMonth, #cboEmp").on('change', function (e) {
			$('#tblInvoices').DataTable().clear().destroy();
			loadRpts();
			getHours();
			ScheduledSessions();
			getInvoices();
		});
	});
	function getHours() {
		$.get("/home/getHours?month=" + $("#dtMonth").val(), function (responseText) {
			if (!responseText) {
				return;
			}
			$("#tbHours").html(responseText);
		});
	}
	function getInvoices() {
		$.get("/home/getInvoices?month=" + $("#dtMonth").val(), function (responseText) {
			if (!responseText) {
				return;
			}
			$("#dvInvoices").html(responseText);
			sumTable(`tblInvoices`);
		});
	}
	function loadRpts() {
		$.get("/home/rptDash", function (responseText) {
			if (!responseText) {
				$('.charts').hide();
				return;
			}
			const dtlData = responseText.split('¦').filter(Boolean);
			const dtlDHtml = dtlData.map(value => {
				const rptSec = value.split('|');
				const html = createReportSection(rptSec);
				loadReportSection(rptSec);
				return html;
			}).join('');
			$('#dtlD').html(dtlDHtml);
		});
	}
	function createReportSection(rptSec) {
		return `<div class='dtlD ${rptSec[13]}'>
												<h6 id=t${rptSec[10]} class='tRpt' style='text-align: center; background: #2a327d; padding: 4px 0 4px 0; color: white;'>
													${decodeURIComponent(rptSec[3])}
												</h6>
												<div id='c${rptSec[10]}' class='chrt' style='margin-top: 2px;'></div>
											</div>`;
	}
	function loadReportSection(rptSec) {
		const url = `/HRReports/ReportSection?info='${encodeURIComponent(rptSec[1] + "','" + rptSec[2] + "','" + rptSec[5] + "':" + rptSec[0] + ":" + rptSec[10])}`;
		$.get(url, function (responseText) {
			const containerId = `#c${rptSec[10]}`;
			$(containerId).html(responseText);
			const tb = $(`#chrt-tb${rptSec[10]}`);
			if (rptSec[11] === '1') {
				configureHighchart(tb, rptSec);
			} else {
				$(containerId).css('margin-left', '0px');
			}
			if (rptSec[10] != '1015') {
				sumTable(`chrt-tb${rptSec[10]}`);
			}
			if (rptSec[6] === '0') {
				tb.hide();
			} else {
				formatNumericCells();
			}
			if (!$.fn.DataTable.isDataTable('#chrt-tb1015')) {
				$("#chrt-tb1015").DataTable({
					"ordering": false,
					"responsive": true,
					searching: false,
					paging: false,
					info: false,
					lengthChange: false
				});
			}
		});
	}
	function configureHighchart(tb, rptSec) {
		const attrs = {
			'data-graph-height': rptSec[12],
			'data-graph-type': rptSec[9].replace('bar', 'column'),
			'data-graph-container-before': '1'
		};
		if (rptSec[9] === "pie") {
			attrs['data-graph-datalabels-enabled'] = '1';
			$(`#chrt-tb${rptSec[10]} tbody tr`).each(function () {
				$('td:nth-child(2)', this).attr('data-graph-name', $(':nth-child(1)', this).html());
			});
		}
		if (rptSec[8] === '1') {
			attrs['data-graph-inverted'] = '1';
			attrs['data-graph-xaxis-labels-enabled'] = '1';
		}
		tb.attr(attrs).highchartTable();
		$('defs').next().hide();
		$(window).trigger('resize');
	}
	function formatNumericCells() {
		$('.tb-css td').each(function () {
			const $cell = $(this);
			if ($.isNumeric($cell.html())) {
				$cell.html($.number($cell.html(), 2))
					.css('text-align', 'right');
			}
		});
	}
</script>
<script type="text/javascript">
	let events = [];
	function ScheduledSessions() {
			var check = "@chkAdm";
	var emp;
	if (check === "True") {
		emp = $("#cboEmp").val();
	} else {
		emp = 0;
	}
		$.get("/home/ScheduledSessions?month=" + $("#dtMonth").val()+"&emp="+ emp, function(responseText) {
			if (!responseText) {
				return;
			}
			events = JSON.parse(responseText);
			loadCalendar();
			loadDayView();
			dataTbl();
		});
	}
	function showView(view) {
		document.getElementById('dayView').classList.remove('active');
		document.getElementById('monthView').classList.remove('active');
		if (view === 'day') {
			document.getElementById('dayView').classList.add('active');
			loadDayView();
		} else {
			document.getElementById('monthView').classList.add('active');
			loadCalendar();
			// $('.calend').DataTable().draw(false);
		}
	}
	function loadDayView() {
		const eventList = document.getElementById("eventList");
		let date = new Date();
		eventList.innerHTML = "";
		let sortedEvents = events.sort((a, b) => a.day - b.day || a.startTime.localeCompare(b.startTime));
		sortedEvents.forEach(event => {
			let eventItem = document.createElement("li");
			eventItem.innerHTML = `<strong>${event.fday} ${event.Timings} - ${event.StudentName}</strong>: ${event.Guardian} | Subject(s):${event.subjects} | Tutor:${event.tutor} <a class="btn btnsh btn-info btn-xs float-right" href="home/Feedback/${event.Id}" onclick="Feedback(${event.Id},this)" style="margin-top: -1px;">📝 Feedback</a>`;
			if (date.getDate() == parseInt(event.fday)) {
				eventItem.classList.add("blink");
			}
			if (event.Stat == "Scheduled") {
				eventItem.classList.add("bg-primary");
			} else if (event.Stat == "Completed") {
				eventItem.classList.add("bg-success");
			} else if (event.Stat == "Cancel") {
				eventItem.classList.add("bg-danger");
			}
			eventList.appendChild(eventItem);
		});
	}
		function loadCalendar() {
		const calendarBody = document.getElementById("calendarBody");
		const mobileAgenda = document.getElementById("mobileAgenda");
		calendarBody.innerHTML = "";
		mobileAgenda.innerHTML = "";
		const monthVal = $("#dtMonth").val();
		if (!monthVal) return;
		const [year, month] = monthVal.split("-").map(Number);
		const date = new Date(year, month - 1, 1);
		const today = new Date();
		const firstDay = date.getDay();
		const daysInMonth = new Date(
			year,
			month,
			0
		).getDate();
		const statusColors = {
			Scheduled: "#007bff",
			Completed: "#10B981",
			Cancel: "#dc3545"
		};
		// =========================================================
		// CREATE EVENT CARD
		// =========================================================
		function createEvent(event) {
			const borderColor =
				statusColors[event.Stat] || "#10B981";
			const color =
				stringToColor(event.TutorID);
			const eventDiv =
				document.createElement("div");
			eventDiv.className = "calendar-event";
			if (event.Stat === "Cancel") {
				eventDiv.style.cssText = `
					background-size:86px;
					background-position:right bottom;
					background-image:url(/dist/img/cancel.svg);
					background-repeat:no-repeat;
					border-left:4px solid ${borderColor};
					border-radius:6px;
					margin-bottom:6px;
					box-shadow:0 1px 2px rgba(0,0,0,.05);
					font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
					overflow:hidden;
					text-align:left;
				`;
			} else {
				eventDiv.style.cssText = `
					background:#fff;
					border-left:4px solid ${borderColor};
					border-radius:6px;
					margin-bottom:6px;
					box-shadow:0 1px 2px rgba(0,0,0,.05);
					font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
					overflow:hidden;
					text-align:left;
				`;
			}
			eventDiv.innerHTML = `
				<div style="
					padding:5px 7px;
					background:${color};
					color:#fff;
					font-size:.85rem;
					font-weight:500;
				">
					${event.StudentName}
				</div>
				<div style="padding:5px 7px">
					<div style="
						color:${color};
						font-size:.85rem;
						font-weight:600;
					">
						${event.tutor}
						<small style="
							color:${color};
							opacity:.75;
							font-size:.7rem;
							font-weight:500;
						">
							(${event.subjects})
						</small>
					</div>
					<div style="
						margin-top:3px;
						color:${color};
						font-size:.65rem;
						font-weight:600;
					">
						${event.Timings}
					</div>
					<div
						class="btn-div"
						style="margin-top:5px"
					>
						<a
							class="feedback-btn"
							href="home/Feedback/${event.Id}"
							onclick="Feedback(${event.Id},this)"
							title="Click to add feedback"
							style="
								display:inline-block;
								padding:2px 6px;
								background:${color};
								border-radius:4px;
								color:#fff;
								font-size:.7rem;
								font-weight:500;
								text-decoration:none;
							"
						>
							📝 Add Feedback
						</a>
					</div>
				</div>
			`;
			return eventDiv;
		}
		// =========================================================
		// DESKTOP CALENDAR
		// =========================================================
		let weekNumber = 1;
		for (
			let startDay = 1 - firstDay;
			startDay <= daysInMonth;
			startDay += 7
		) {
			const weekId =
				`desktop-week-${weekNumber}`;
			// -----------------------------------------------------
			// WEEK HEADER
			// -----------------------------------------------------
			const weekHeader =
				document.createElement("tr");
			const weekHeaderCell =
				document.createElement("td");
			weekHeaderCell.colSpan = 7;
			weekHeaderCell.style.padding = "3px 0";
			weekHeaderCell.innerHTML = `
				<div
					class="calendar-week-header"
					style="
						display:flex;
						align-items:center;
						justify-content:space-between;
						padding:5px 8px;
						background:#f8fafc;
						border:1px solid #e2e8f0;
						border-radius:5px;
						color:#475569;
						font-size:.72rem;
						font-weight:600;
						cursor:pointer;
					"
				>
					<span>Week ${weekNumber}</span>
					<span
						id="${weekId}-icon"
						style="font-size:.65rem"
					>
						▲
					</span>
				</div>
			`;
			weekHeader.appendChild(weekHeaderCell);
			calendarBody.appendChild(weekHeader);
			// -----------------------------------------------------
			// WEEK ROW
			// -----------------------------------------------------
			const row =
				document.createElement("tr");
			row.id = weekId;
			// -----------------------------------------------------
			// 7 DAYS
			// -----------------------------------------------------
			for (let i = 0; i < 7; i++) {
				const day =
					startDay + i;
				const cell =
					document.createElement("td");
				cell.className =
					"calendar-day";
				// Empty cell
				if (
					day < 1 ||
					day > daysInMonth
				) {
					row.appendChild(cell);
					continue;
				}
				// -------------------------------------------------
				// TODAY
				// -------------------------------------------------
				if (
					today.getDate() === day &&
					today.getMonth() === date.getMonth() &&
					today.getFullYear() === date.getFullYear()
				) {
					cell.classList.add("blink");
				}
				// -------------------------------------------------
				// DAY NUMBER
				// -------------------------------------------------
				const dayNumber =
					document.createElement("span");
				dayNumber.className =
					"day-number";
				dayNumber.textContent =
					day;
				cell.appendChild(dayNumber);
				// -------------------------------------------------
				// EVENTS
				// -------------------------------------------------
				const dayEvents =
					events.filter(
						event => event.day === day
					);
				dayEvents.forEach(event => {
					cell.appendChild(
						createEvent(event)
					);
				});
				row.appendChild(cell);
			}
			calendarBody.appendChild(row);
			// -----------------------------------------------------
			// TOGGLE WEEK
			// -----------------------------------------------------
			weekHeaderCell
				.querySelector(".calendar-week-header")
				.addEventListener("click", function () {
					const collapsed =
						row.style.display === "none";
					row.style.display =
						collapsed
							? "table-row"
							: "none";
					document.getElementById(
						`${weekId}-icon`
					).textContent =
						collapsed ? "▲" : "▼";
				});
			weekNumber++;
		}
		// =========================================================
		// MOBILE SINGLE-COLUMN AGENDA
		// =========================================================
		weekNumber = 1;
		for (
			let startDay = 1 - firstDay;
			startDay <= daysInMonth;
			startDay += 7
		) {
			const weekId =
				`mobile-week-${weekNumber}`;
			// -----------------------------------------------------
			// WEEK CONTAINER
			// -----------------------------------------------------
			const week =
				document.createElement("div");
			week.className =
				"agenda-week";
			// -----------------------------------------------------
			// WEEK HEADER
			// -----------------------------------------------------
			const weekHeader =
				document.createElement("div");
			weekHeader.className =
				"agenda-week-header";
			weekHeader.innerHTML = `
				<span>
					Week ${weekNumber}
				</span>
				<span
					id="${weekId}-icon"
				>
					▲
				</span>
			`;
			week.appendChild(weekHeader);
			// -----------------------------------------------------
			// WEEK CONTENT
			// -----------------------------------------------------
			const weekContent =
				document.createElement("div");
			weekContent.id =
				weekId;
			// -----------------------------------------------------
			// DAYS
			// -----------------------------------------------------
			for (let i = 0; i < 7; i++) {
				const day =
					startDay + i;
				if (
					day < 1 ||
					day > daysInMonth
				) {
					continue;
				}
				const currentDate =
					new Date(
						year,
						month - 1,
						day
					);
				const dayEvents =
					events.filter(
						event => event.day === day
					);
				// -------------------------------------------------
				// DAY CONTAINER
				// -------------------------------------------------
				const dayContainer =
					document.createElement("div");
				dayContainer.className =
					"agenda-day";
				// -------------------------------------------------
				// TODAY
				// -------------------------------------------------
				const isToday =
					today.getDate() === day &&
					today.getMonth() === date.getMonth() &&
					today.getFullYear() === date.getFullYear();
				// -------------------------------------------------
				// DATE HEADER
				// -------------------------------------------------
				const dateHeader =
					document.createElement("div");
				dateHeader.className =
					"agenda-date" +
					(isToday ? " today" : "");
				const dayName =
					currentDate.toLocaleDateString(
						"en-US",
						{
							weekday: "short"
						}
					);
				dateHeader.innerHTML = `
					<span>
						${dayName}
					</span>
					<span>
						${day}
					</span>
				`;
				dayContainer.appendChild(
					dateHeader
				);
				// -------------------------------------------------
				// EVENTS
				// -------------------------------------------------
				if (dayEvents.length > 0) {
					dayEvents.forEach(event => {
						const eventElement =
							createEvent(event);
						eventElement.classList.add(
							"agenda-event"
						);
						dayContainer.appendChild(
							eventElement
						);
					});
				} else {
					// No sessions
					const empty =
						document.createElement("div");
					empty.className =
						"agenda-empty";
					empty.textContent =
						"No sessions";
					dayContainer.appendChild(
						empty
					);
				}
				weekContent.appendChild(
					dayContainer
				);
			}
			week.appendChild(
				weekContent
			);
			// -----------------------------------------------------
			// TOGGLE MOBILE WEEK
			// -----------------------------------------------------
			weekHeader.addEventListener(
				"click",
				function () {
					const collapsed =
						weekContent.style.display === "none";
					weekContent.style.display =
						collapsed
							? "block"
							: "none";
					document.getElementById(
						`${weekId}-icon`
					).textContent =
						collapsed ? "▲" : "▼";
				}
			);
			mobileAgenda.appendChild(
				week
			);
			weekNumber++;
		}
	}
