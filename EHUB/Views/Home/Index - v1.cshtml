@using EHUB.Utilities
@{
	ViewData["Title"] = "Dashboard";
	var uinfo = User.Claims.ToArray();
	var authRights = new AuthRights();
	var chk = authRights.chk();
	var mgr = authRights.mgr();
	var gM = new GM();
	var chkAdm = uinfo[3].Value != "18" && uinfo[3].Value != "19" ? true : false;
}
<style>
	.controls {
		margin: 6px 0px 6px 4px;
	}
	.calendar, .day-view {
		display: none;
	}
	.active {
		display: block;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		transform: scale(calc(100vw / 1200));
		table-layout: auto;
	}
	th, td {
		border: 1px solid #ddd;
		padding: 10px;
		text-align: center;
		position: relative;
		/* white-space: nowrap; */
	}
	.event {
		font-size: 12px;
		color: white;
		background-color: blue;
		padding: 2px;
		border-radius: 4px;
		display: block;
		margin-top: 2px;
		text-align: left;
		padding-left: 9px;
	}
	.event-time {
		font-size: 10px;
		display: block;
		color: #fff;
	}
	.event-form {
		margin-bottom: 20px;
	}
	.day-view .event-list {
		list-style: none;
		padding: 0;
	}
		.day-view .event-list li {
			padding: 5px;
			border: 1px solid #ddd;
			margin: 5px 0;
			background: lightblue;
		}
	.event-list li:hover .btnsh {
		opacity: 1;
		display: inline;
	}
	.btnsh {
		opacity: 0;
	}
	.small-input-group .input-group-text,
	.small-input-group .form-control {
		font-size: 12px;
		height: 28px;
		padding: 2px 6px;
	}
	.day-number {
		background-color: #2a327d;
		color: #FFFFFF;
		box-shadow: 0 2px 4px rgba(37, 99, 235, 0.3);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 6px;
	}
</style>
<style>
	.calend {
		border-collapse: collapse;
		box-shadow: 0 0 10px rgba(0,0,0,0.1);
		background: white;
		border-radius: 12px;
		overflow: hidden;
	}
		.calend th {
			background-color: #2a327d;
			color: white;
			padding: 10px;
			text-align: center;
		}
		.calend td {
			border: 1px solid #ddd;
			height: 80px;
			text-align: right;
			padding: 5px;
			vertical-align: top;
		}
			.calend td.other-month {
				color: #aaa;
				background-color: #f0f0f0;
			}
			.calend td.today {
				background-color: #cce5ff;
			}
	td:nth-child(even) {
		background-color: #fafafa;
	}
	/* Odd columns */
	td:nth-child(odd) {
		background-color: #ffffff;
	}
	.calendar-event .feedback-btn {
		max-height: 0;
		opacity: 0.4;
		display: inline-block;
		overflow: hidden;
		transform: translateY(-8px);
		transition: max-height 0.3s ease, opacity 0.25s ease, transform 0.3s ease;
	}
	.calendar-event:hover .feedback-btn {
		max-height: 40px;
		opacity: 1;
		transform: translateY(0);
	}
	.calendar-event .btn-div {
		height: 0;
		padding-bottom: 8px;
	}
	.calendar-event:hover .btn-div {
		margin-top: 5px;
		height: auto;
		padding-bottom: unset;
	}
</style>
<style type="text/css">
	/* Desktop */
	.calendar-desktop {
		display: block;
	}
	.mobile-agenda {
		display: none;
	}
	/* Mobile */
	@@media (max-width: 767px) {
		.calendar-desktop {
			display: none;
		}
		.mobile-agenda {
			display: block;
			width: 100%;
		}
		.agenda-week {
			margin-bottom: 8px;
			border-radius: 6px;
			overflow: hidden;
		}
		.agenda-week-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 6px 9px;
			background: #f8fafc;
			border-bottom: 1px solid #e2e8f0;
			color: #475569;
			font-size: .72rem;
			font-weight: 600;
			cursor: pointer;
		}
		.agenda-day {
			padding: 6px 0;
			border-bottom: 1px solid #e2e8f0;
		}
		.agenda-date {
			display: flex;
			align-items: center;
			gap: 6px;
			margin-bottom: 5px;
			padding: 0 5px;
			color: #475569;
			font-size: .72rem;
			font-weight: 600;
		}
			.agenda-date.today {
				color: #82b74b;
			}
		.agenda-event {
			margin: 3px 5px;
		}
		.agenda-empty {
			padding: 4px 8px;
			color: #94a3b8;
			font-size: .65rem;
		}
	}
</style>
<section class="content">
	<div class="card" style="
 background: none;
 box-shadow: none;
">
		<div class="card-body p-0">
			<div class="row">
				@if (chkAdm)
				{
					<div class="col-md-3">
						<div class="card-tools" style="width: 100%;padding: 2px 2px 0 2px;">
							<div class="input-group small-input-group">
								<div class="input-group-prepend">
									<span class="input-group-text">Tutor</span>
								</div>
								<select class="form-control" id="cboEmp" asp-items="Model.emps">
									<option value="0">ALL</option>
								</select>
							</div>
						</div>
					</div>
				}
				<div class="col-md-3">
					<div class="card-tools" style="max-width: 185px;padding: 2px 2px 0 2px;">
						<div class="input-group small-input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Month</span>
							</div>
							<input type="month"
								   id="dtMonth"
								   name="dtMonth"
								   value="@DateTime.Now.ToString("yyyy-MM")"
