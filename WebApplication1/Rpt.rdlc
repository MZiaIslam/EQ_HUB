                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=iif(Fields!Attyp.Value="L","  Leave",iif(Fields!Attyp.Value="PH","PUBLIC HOLIDAY",iif(Fields!Attyp.Value="NH","NATIONAL HOLIDAY",iif(Fields!Attyp.Value="OFF","DAY OFF",format(Max(Fields!ATT_TIME.Value),"hh:mm tt")))))</Value>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontSize>7pt</FontSize>
                                <Format>h:mm tt</Format>
                                <Color>=iif(Fields!ltIN.Value&gt;15,"Red","Black")</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>="&lt;sup&gt;"+Fields!inr.Value+"&lt;/sup&gt;"</Value>
                              <MarkupType>HTML</MarkupType>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontSize>7pt</FontSize>
                                <Format>h:mm tt</Format>
                                <Color>Red</Color>
